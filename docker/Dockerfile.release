# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.05-py3
FROM ${BASE_IMAGE} AS inference
ARG TARGETARCH
# Cache mounts stay out of layers. Reset with: docker buildx prune --filter type=exec.cachemount

ENV DEBIAN_FRONTEND=noninteractive
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV UV_SYSTEM_PYTHON=1
ENV PATH=/opt/cuteafd/bin:${PATH}
ENV PYTHONPATH=/opt/cuteafd/third_party/sparkinfer:/opt/cuteafd/python/reference/cuteafd_reference:/opt/cuteafd/python/reference
ENV CUTEAFD_NATIVE_LIB=/opt/cuteafd/lib/libcuteafd_native.so

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash ca-certificates curl jq tini \
      rdma-core ibverbs-providers libibverbs1 \
      libnl-3-200 libnl-route-3-200 \
      iproute2 pciutils netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/pip,id=cuteafd-pip-${TARGETARCH},sharing=locked \
    --mount=type=cache,target=/root/.cache/uv,id=cuteafd-uv-${TARGETARCH},sharing=locked \
    python3 -m pip install uv && \
    uv pip install --system --break-system-packages \
      safetensors \
      huggingface-hub \
      "nvidia-cutlass-dsl[cu13]==4.6.2" \
      "apache-tvm-ffi==0.1.12" \
      "cuda-tile==1.5.0" \
      "nvidia-cudnn-frontend==1.26.0" \
      "einops==0.8.2" \
      "ninja==1.13.0" \
      "nvidia-ml-py==13.610.43" \
      "tabulate==0.10.0" \
      "transformers==5.13.0" \
      "rich==15.0.0" && \
    uv pip install --system --break-system-packages --no-deps \
      "flashinfer-python==0.6.14" && \
    python3 -c 'import torch; print(torch.__version__)'

# The NGC 26.05 base declares pytest as a runtime requirement of its bundled
# triton-kernels distribution. Keep the release environment dependency-complete
# so the source-pinned SparkInfer installation can be checked globally below.
RUN --mount=type=cache,target=/root/.cache/uv,id=cuteafd-uv-${TARGETARCH},sharing=locked \
    uv pip install --system --break-system-packages pytest

# Keep source/revision metadata after the expensive immutable dependency
# layers. Rapid SparkInfer iteration should invalidate only the pinned-source
# and release-material tail of this image.
ARG CUTEAFD_ROLE
ARG CUDA_ARCH
ARG CUTEAFD_ENGINE_COMMIT=unknown
ARG CUTEAFD_SPARKINFER_COMMIT=unknown
ARG CUTEAFD_RELEASE_VERSION=unknown
# Replicated-group SM121 expert roles compiled into this image (semicolon list
# `tp2`/`tp3`/`tp6`). ./build.sh resolves them, universal by default, and passes an
# empty value for the coordinator: the verification below rejects any role label the
# built manifest and shipped library do not corroborate.
ARG CUTEAFD_SPARK_TP_ROLES=

ENV CUTEAFD_ROLE=${CUTEAFD_ROLE}
ENV CUTEAFD_CUDA_ARCH=${CUDA_ARCH}
ENV CUTEAFD_ENGINE_COMMIT=${CUTEAFD_ENGINE_COMMIT}
ENV CUTEAFD_SPARKINFER_COMMIT=${CUTEAFD_SPARKINFER_COMMIT}
ENV CUTEAFD_RELEASE_VERSION=${CUTEAFD_RELEASE_VERSION}
ENV CUTEAFD_SPARK_TP_ROLES=${CUTEAFD_SPARK_TP_ROLES}

LABEL org.opencontainers.image.title="CUTEAFD inference"
LABEL org.opencontainers.image.source="https://github.com/tpurtell/cuteafd"
LABEL org.opencontainers.image.description="DeepSeek V4.1 Flash inference for one or two RTX PRO 6000 GPUs and four DGX Spark expert workers"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.revision=${CUTEAFD_ENGINE_COMMIT}
LABEL org.opencontainers.image.version=${CUTEAFD_RELEASE_VERSION}
LABEL org.cuteafd.console-gate="1"
LABEL io.cuteafd.role=${CUTEAFD_ROLE}
LABEL io.cuteafd.cuda_arch=${CUDA_ARCH}
LABEL io.cuteafd.sparkinfer.revision=${CUTEAFD_SPARKINFER_COMMIT}
LABEL io.cuteafd.spark_tp_roles=${CUTEAFD_SPARK_TP_ROLES}
# The pre-rename label, set for one release so older launchers still read it.
LABEL io.cuteafd.v41.spark_tp_roles=${CUTEAFD_SPARK_TP_ROLES}

COPY scripts/build/verify-sparkinfer-source.py /opt/cuteafd/scripts/build/verify-sparkinfer-source.py
COPY scripts/build/sparkinfer-release-provenance.py /opt/cuteafd/scripts/build/sparkinfer-release-provenance.py
COPY third_party/sparkinfer.lock.json /opt/cuteafd/third_party/sparkinfer.lock.json
COPY third_party/sparkinfer /opt/cuteafd/third_party/sparkinfer

RUN --mount=type=cache,target=/root/.cache/uv,id=cuteafd-uv-${TARGETARCH},sharing=locked \
    python3 /opt/cuteafd/scripts/build/verify-sparkinfer-source.py \
      --source /opt/cuteafd/third_party/sparkinfer \
      --lock /opt/cuteafd/third_party/sparkinfer.lock.json && \
    locked_revision="$(python3 /opt/cuteafd/scripts/build/verify-sparkinfer-source.py \
      --source /opt/cuteafd/third_party/sparkinfer \
      --lock /opt/cuteafd/third_party/sparkinfer.lock.json \
      --print-revision)" && \
    [ "${CUTEAFD_SPARKINFER_COMMIT}" != unknown ] && \
    [ "${CUTEAFD_SPARKINFER_COMMIT}" = "$locked_revision" ] && \
    uv pip install --system --break-system-packages --no-deps \
      --editable /opt/cuteafd/third_party/sparkinfer && \
    uv pip check && \
    python3 -c 'import importlib.metadata, pathlib, b12x; source = pathlib.Path("/opt/cuteafd/third_party/sparkinfer").resolve(); module = pathlib.Path(b12x.__file__).resolve(); assert module.is_relative_to(source), (module, source); print(importlib.metadata.version("b12x"), module)' && \
    python3 /opt/cuteafd/scripts/build/verify-sparkinfer-source.py \
      --source /opt/cuteafd/third_party/sparkinfer \
      --lock /opt/cuteafd/third_party/sparkinfer.lock.json \
      --require-no-python-cache

# tool-eval-bench (MIT, pinned submodule) for the benchmark's tool-eval panel,
# which runs it as a subprocess against the server's own API.
COPY scripts/build/verify-tool-eval-source.py /opt/cuteafd/scripts/build/verify-tool-eval-source.py
COPY third_party/tool-eval-bench.lock.json /opt/cuteafd/third_party/tool-eval-bench.lock.json
COPY third_party/tool-eval-bench /opt/cuteafd/third_party/tool-eval-bench
RUN --mount=type=cache,target=/root/.cache/uv,id=cuteafd-uv-${TARGETARCH},sharing=locked \
    if [ "$CUTEAFD_ROLE" = coordinator ]; then \
      python3 /opt/cuteafd/scripts/build/verify-tool-eval-source.py \
        --source /opt/cuteafd/third_party/tool-eval-bench \
        --lock /opt/cuteafd/third_party/tool-eval-bench.lock.json && \
      revision="$(python3 /opt/cuteafd/scripts/build/verify-tool-eval-source.py \
        --source /opt/cuteafd/third_party/tool-eval-bench \
        --lock /opt/cuteafd/third_party/tool-eval-bench.lock.json --print-revision)" && \
      SETUPTOOLS_SCM_PRETEND_VERSION="0.0.0+g${revision%"${revision#???????}"}" \
        uv pip install --system --break-system-packages /opt/cuteafd/third_party/tool-eval-bench && \
      uv pip check && tool-eval-bench --help >/dev/null; \
    else rm -rf /opt/cuteafd/third_party/tool-eval-bench; fi

COPY .cuteafd-release-image/cuteafd /opt/cuteafd/bin/cuteafd
COPY .cuteafd-release-image/libcuteafd_native.so /opt/cuteafd/lib/libcuteafd_native.so
COPY .cuteafd-release-image/exl3 /opt/cuteafd/lib/exl3
COPY .cuteafd-release-image/fp8 /opt/cuteafd/lib/fp8
COPY .cuteafd-release-image/V41_EXPERT_AOT.json /opt/cuteafd/share/V41_EXPERT_AOT.json
COPY .cuteafd-release-image/V41_EXPERT_TP_AOT.json /opt/cuteafd/share/V41_EXPERT_TP_AOT.json
COPY .cuteafd-release-image/V41_FP8_AOT.json /opt/cuteafd/share/V41_FP8_AOT.json
COPY .cuteafd-release-image/PROGRAMS.json /opt/cuteafd/share/PROGRAMS.json
COPY .cuteafd-release-image/THIRD_PARTY_NOTICES.md /opt/cuteafd/share/THIRD_PARTY_NOTICES.md
COPY .cuteafd-release-image/SPARKINFER_PROVENANCE.json /opt/cuteafd/share/SPARKINFER_PROVENANCE.json
COPY .cuteafd-release-image/SPARKINFER_LICENSE /opt/cuteafd/share/SPARKINFER_LICENSE
COPY .cuteafd-release-image/SPARKINFER_SHA256SUMS /opt/cuteafd/share/SPARKINFER_SHA256SUMS
COPY .cuteafd-release-image/XGRAMMAR_PROVENANCE.json /opt/cuteafd/share/XGRAMMAR_PROVENANCE.json
COPY .cuteafd-release-image/XGRAMMAR_LICENSE /opt/cuteafd/share/XGRAMMAR_LICENSE
COPY .cuteafd-release-image/XGRAMMAR_SHA256SUMS /opt/cuteafd/share/XGRAMMAR_SHA256SUMS
COPY python /opt/cuteafd/python
COPY scripts/build/kernel-cache-identity.py /opt/cuteafd/scripts/build/kernel-cache-identity.py
COPY docker/release-entrypoint.sh /usr/local/bin/cuteafd-release-entrypoint

# Bake-time artifact corroboration, inside the existing verification layer: the
# role manifest is written by scripts/build/write-v41-expert-tp-manifest.py from the AOT
# export that was actually built, never from a build-arg, so a library the
# manifest does not name, or a role set it does not record, is a stale or partial
# .cuteafd-release-image directory rather than a built image. Existing manifest
# schema only, no new verifier. Kernel execution and numerical/device
# qualification remain the hardware gate the release checklist records.
RUN for exl3_family in /opt/cuteafd/lib/exl3/exl3-*/; do \
      python3 /opt/cuteafd/python/tools/aot/package_exl3_aot.py verify \
        --package "$exl3_family" --sparkinfer-revision "$CUTEAFD_SPARKINFER_COMMIT" \
        --role "$CUTEAFD_ROLE" --runtime "$(python3 -m cutlass.cute.export.aot_config --libdir)/libcute_dsl_runtime.so"; \
    done && \
    for fp8_family in /opt/cuteafd/lib/fp8/fp8-*/; do \
      [ -d "$fp8_family" ] || continue; \
      python3 /opt/cuteafd/python/tools/aot/package_fp8_moe_aot.py verify --package "$fp8_family" \
        --sparkinfer-revision "$CUTEAFD_SPARKINFER_COMMIT" --role "$CUTEAFD_ROLE"; \
    done && \
    jq -e --arg role "$CUTEAFD_ROLE" --arg claimed "$CUTEAFD_SPARK_TP_ROLES" --arg lib "$(sha256sum /opt/cuteafd/lib/libcuteafd_native.so | cut -d" " -f1)" '($claimed | split(";") | map(select(. != "")) | sort) as $want | . as $doc | $doc.role == $role and $doc.native_library_sha256 == $lib and (($doc.spark_tp_roles // []) | sort) == $want and (($doc.manifests // {}) | keys | sort) == $want' /opt/cuteafd/share/V41_EXPERT_TP_AOT.json && \
    cmp -s \
      /opt/cuteafd/third_party/sparkinfer/LICENSE \
      /opt/cuteafd/share/SPARKINFER_LICENSE && \
    (cd /opt/cuteafd/share && sha256sum -c SPARKINFER_SHA256SUMS) && \
    (cd /opt/cuteafd/share && sha256sum -c XGRAMMAR_SHA256SUMS) && \
    python3 /opt/cuteafd/scripts/build/sparkinfer-release-provenance.py \
      --source /opt/cuteafd/third_party/sparkinfer \
      --lock /opt/cuteafd/third_party/sparkinfer.lock.json \
      --license /opt/cuteafd/share/SPARKINFER_LICENSE \
      --notices /opt/cuteafd/share/THIRD_PARTY_NOTICES.md \
      --verify /opt/cuteafd/share/SPARKINFER_PROVENANCE.json && \
    install -D -m 0644 \
      /opt/cuteafd/share/SPARKINFER_LICENSE \
      /opt/cuteafd/share/licenses/sparkinfer/LICENSE && \
    install -D -m 0644 \
      /opt/cuteafd/share/XGRAMMAR_LICENSE \
      /opt/cuteafd/share/licenses/xgrammar/LICENSE && \
    chmod +x \
      /opt/cuteafd/bin/cuteafd \
      /usr/local/bin/cuteafd-release-entrypoint

WORKDIR /opt/cuteafd
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cuteafd-release-entrypoint"]
CMD ["cuteafd", "--help"]
