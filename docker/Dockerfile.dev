# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.05-py3@sha256:222d8b18e671be5c3ef91cb41727a2572a0b23f59ded6c39f373a96946f6f2ba
FROM ${BASE_IMAGE}
ARG TARGETARCH
# Cache mounts stay out of layers. Reset with: docker buildx prune --filter type=exec.cachemount

ENV DEBIAN_FRONTEND=noninteractive
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV CARGO_HOME=/opt/cargo
ENV RUSTUP_HOME=/opt/rustup
ENV PATH=/opt/cargo/bin:${PATH}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash ca-certificates curl git git-lfs jq ripgrep pkg-config \
      build-essential clang cmake ninja-build nasm python3-venv \
      rdma-core ibverbs-providers libibverbs-dev perftest \
      openssh-client netcat-openbsd iproute2 pciutils && \
    mkdir -p /opt/cuteafd && dpkg -l > /opt/cuteafd/dpkg-packages.txt && \
    rm -rf /var/lib/apt/lists/*

# Pinned toolchain: a release at least two weeks old, so builds do not move under us.
ARG RUST_TOOLCHAIN=1.98.1
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain ${RUST_TOOLCHAIN} && \
    rustup component add rustfmt

ARG KACHE_VERSION=1.0.0
ARG SCCACHE_VERSION=0.18.0
COPY scripts/build/install-dev-cache-tools.sh /opt/cuteafd/install-dev-cache-tools.sh
RUN KACHE_VERSION=${KACHE_VERSION} SCCACHE_VERSION=${SCCACHE_VERSION} bash /opt/cuteafd/install-dev-cache-tools.sh

ENV UV_SYSTEM_PYTHON=1

# Transformers itself comes from the mounted checkout
# (third_party/transformers/src, put on the path by its importers); the image
# installs only that pinned source's runtime dependencies. tokenizers is pinned
# to the version the checkout requires, never the one a PyPI Transformers drags in.
RUN --mount=type=cache,target=/root/.cache/pip,id=cuteafd-pip-${TARGETARCH},sharing=locked \
    --mount=type=cache,target=/root/.cache/uv,id=cuteafd-uv-${TARGETARCH},sharing=locked \
    python3 -m pip install "uv==0.12.23" && \
    uv pip install --system --break-system-packages \
      "pytest==9.1.1" \
      "safetensors==0.8.0" \
      "huggingface-hub==1.14.0" \
      "tokenizers==0.23.1" && \
    uv pip install --system --break-system-packages \
      "nvidia-cutlass-dsl[cu13]==4.6.2" \
      "apache-tvm-ffi==0.1.12" \
      "cuda-tile==1.5.0" \
      "nvidia-cudnn-frontend==1.26.0" \
      "einops==0.8.2" \
      "ninja==1.13.0" \
      "nvidia-ml-py==13.610.43" \
      "pillow==12.2.0" \
      "tabulate==0.10.0" \
      "rich==15.0.0" && \
    uv pip install --system --break-system-packages --no-deps \
      "flashinfer-python==0.6.14"

# Toolchain only: kernels and their lock come from the mounted checkout.
RUN uv pip check
ARG BASE_IMAGE
ARG CUTEAFD_ENGINE_COMMIT=unknown
ARG CUTEAFD_TOOLCHAIN_HASH=unknown
LABEL org.opencontainers.image.source="https://github.com/tpurtell/cuteafd" \
      org.opencontainers.image.revision=${CUTEAFD_ENGINE_COMMIT} \
      org.opencontainers.image.description="CuteAFD build toolchain; mount the checkout for SparkInfer kernels" \
      io.cuteafd.base.digest=${BASE_IMAGE} \
      io.cuteafd.rust.version=${RUST_TOOLCHAIN} \
      io.cuteafd.cutlass-dsl.version="4.6.2" \
      io.cuteafd.kache.version=${KACHE_VERSION} \
      io.cuteafd.sccache.version=${SCCACHE_VERSION} \
      io.cuteafd.toolchain.hash=${CUTEAFD_TOOLCHAIN_HASH}

WORKDIR /workspace/cuteafd
ENV PYTHONPATH=/workspace/cuteafd/third_party/sparkinfer:/workspace/cuteafd/python/reference/cuteafd_reference:/workspace/cuteafd/python/reference
COPY docker/entrypoint.sh /usr/local/bin/cuteafd-entrypoint
RUN chmod +x /usr/local/bin/cuteafd-entrypoint

ENTRYPOINT ["/usr/local/bin/cuteafd-entrypoint"]
CMD ["bash"]
