.cuteafd-source-revision
# Tool-evaluation output generated in the repository root.
data/benchmarks.sqlite
runs/
reports/phase0_artifacts/*.tmp
reports/phase0_artifacts/benchmarks/*.tmp
reports/phase0_artifacts/model_catalog_python.json
reports/phase0_artifacts/loadplan_range.*.json
reports/phase0_artifacts/logs/
