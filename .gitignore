# Content-addressed calibration/replay payloads stay in durable local storage;
# commit their manifests and hashes, not raw activation rows.
reports/quantization/router-replay-inputs/*.bf16
reports/quantization/router-replay-inputs/*.bin
.cuteafd-wip
run-agent.sh
native/build-nvfp4-share/
runs/

# Local native build trees are machine-specific and never committable.
native/build-sampling/
# SQLite WAL/SHM sidecars of local benchmark/telemetry databases.
data/*.sqlite-*
# Local scratch (never /mnt/scratch).
/.cache/

# Source identity for builds without .git (scripts/build/write-build-identity.sh)
BUILD_IDENTITY.json
.venv
# PeerSwarm local runtime state (peer worktrees, shared caches, SQLite DB, dated artifacts)
peerswarm.state/
.claude/worktrees/
.claude/scheduled_tasks.lock
