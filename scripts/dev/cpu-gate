def log(message):
    print(f'cpu-gate: {message}', file=sys.stderr, flush=True)


def checked(cmd, **kwargs):
    result = subprocess.run(cmd, text=True, capture_output=True, **kwargs)
    if result.returncode:
        raise SystemExit(f'cpu-gate: {cmd[0]} {" ".join(cmd[1:3])} failed: {(result.stderr or result.stdout).strip()[-400:]}')
    return result.stdout


def gate_venv_for(env=None):
    """Shared host gate venv (~/.cache/cuteafd/gate-venv); preferred over a main
    checkout's .venv so worktrees on maxq never fall back to the quant venv."""
    home = Path((os.environ if env is None else env).get('HOME') or Path.home())
    return home / '.cache/cuteafd/gate-venv'


def parse_requirements(path=GATE_REQUIREMENTS):
    expected = {}
    for raw in path.read_text().splitlines():
        line = raw.split('#', 1)[0].strip()
        if not line:
            continue
        name, sep, version = line.partition('==')
        if not sep or not name.strip() or not version.strip():
            raise SystemExit(f'cpu-gate: invalid requirement in {path}: {raw!r}')
        expected[re.sub(r'[-_.]+', '-', name.strip()).lower()] = version.strip()
    return expected


def installed_packages(python):
    probe = ('import importlib.metadata as m, json, re; '
             'print(json.dumps({re.sub(r"[-_.]+", "-", d.metadata["Name"]).lower(): d.version '
             'for d in m.distributions() if d.metadata.get("Name")}))')
    result = subprocess.run([str(python), '-c', probe], text=True, capture_output=True, timeout=30)
    if result.returncode:
        raise SystemExit(f'cpu-gate: failed to inspect venv {python}: {(result.stderr or result.stdout).strip()[-400:]}')
    return json.loads(result.stdout)


def check_venv(python, requirements=GATE_REQUIREMENTS):
    expected = parse_requirements(requirements)
    actual = installed_packages(python)
    missing = [f'{name}=={ver}' for name, ver in sorted(expected.items()) if name not in actual]
    wrong = [f'{name}=={actual[name]} (expected {ver})' for name, ver in sorted(expected.items())
             if name in actual and actual[name] != ver]
    extra = [f'{name}=={ver}' for name, ver in sorted(actual.items()) if name not in expected]
    problems = ([f"missing: {', '.join(missing[:8])}" + (f' (+{len(missing) - 8} more)' if len(missing) > 8 else '')] if missing else []) + \
               ([f"version mismatch: {', '.join(wrong[:8])}" + (f' (+{len(wrong) - 8} more)' if len(wrong) > 8 else '')] if wrong else []) + \
               ([f"unexpected packages: {', '.join(extra[:8])}" + (f' (+{len(extra) - 8} more)' if len(extra) > 8 else '')] if extra else [])
    if problems:
        venv = Path(python).parent.parent
        raise SystemExit(f'cpu-gate: venv {python} does not match {requirements} ({"; ".join(problems)}); '
                         f'sync with: uv pip sync --python {venv}/bin/python {requirements}')
    return python


def python_for(source):
    common = Path(checked(['git', '-C', str(source), 'rev-parse', '--path-format=absolute', '--git-common-dir']).strip()).parent
    candidates = [*([] if source.resolve() == common.resolve() else [source / '.venv/bin/python']),
                  gate_venv_for() / 'bin/python', REPO / '.venv/bin/python', common / '.venv/bin/python']
    for candidate in candidates:
        if candidate.is_file():
            return check_venv(candidate)
    raise SystemExit(f'cpu-gate: no .venv here, in ~/.cache/cuteafd/gate-venv, or in the main checkout '
                     f'(uv venv --python 3.12 .venv && uv pip sync --python .venv/bin/python {GATE_REQUIREMENTS}; see AGENTS.md)')


def prepare(source, root, owned=False):
    checked([sys.executable, str(source / 'scripts/build/assert-build-filesystem.py'), str(root)])
    for path in (root / 'tmp', root / 'logs'):
        path.mkdir(parents=True, exist_ok=True)
    # `submodule update` checks out the commit HEAD records, so an uncommitted pin bump (a gitlink
    # staged or changed but not committed) would be silently reset and the gate would test the old
    # kernels. Refuse instead: commit the pin bump, then gate. The --base worktree is the gate's
    # own (owned): it is re-detached at each base, so its submodules still sit at the previous
    # base's pins until the update below moves them, which is exactly what should happen there.
    moved = [] if owned else pin_changes(source)
    if moved:
        raise SystemExit('cpu-gate: submodule pins differ from HEAD (commit the bump first): ' + ', '.join(moved))
    log(f'submodules at their pinned commits ({source})')
    checked(['git', '-C', str(source), 'submodule', 'update', '--init', '--recursive'], timeout=1800)
    checked([sys.executable, str(source / 'scripts/build/verify-sparkinfer-source.py'), '--source',
             str(source / 'third_party/sparkinfer'), '--lock', str(source / 'third_party/sparkinfer.lock.json')])


def pin_changes(source):
    """Submodule paths whose staged or checked-out commit differs from the one HEAD records."""
    moved = set()
    for cached in (True, False):
        # --ignore-submodules=dirty: only a moved commit counts, not edits inside a submodule.
        cmd = ['git', '-C', str(source), 'diff', '--raw', '--ignore-submodules=dirty']
        out = subprocess.run(cmd + (['--cached'] if cached else []) + ['HEAD'],
                             capture_output=True, text=True, check=True).stdout
        for line in out.splitlines():
            meta, _, path = line.partition('\t')
            if '160000' in meta.split()[:2]:
                moved.add(path)
    return sorted(moved)


def run_logged(cmd, log_path, env, cwd, timeout):
    started = time.monotonic()
    with open(log_path, 'w') as output:
        if STOPPING.is_set():
            output.write('cpu-gate: terminated before start\n')
            return 130, 0.0
        # Own session: an interrupt or timeout stops the whole tree (rustc, test binaries, xdist workers).
        process = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=output, stderr=subprocess.STDOUT, start_new_session=True)
        with CHILDREN_LOCK:
            CHILDREN.add(process)
        try:
            code = process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            stop_tree(process)
            code = 124
            output.write(f'\ncpu-gate: timed out after {timeout} s\n')
        finally:
            stop_tree(process)
            with CHILDREN_LOCK:
                CHILDREN.discard(process)
    return code, time.monotonic() - started


def stop_tree(process):
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        pass
    try:
        process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        pass
    # Kill the group even if its leader exited: descendants may ignore TERM.
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    process.wait()


def interrupt(signum, frame):
    global TERMINATED_SIGNAL
    if STOPPING.is_set():
        return  # already unwinding toward cleanup
    STOPPING.set()
    TERMINATED_SIGNAL = signum
    with CHILDREN_LOCK:
        running = list(CHILDREN)
    # Stop children before the executor joins; a TERM-ignoring compile must
    # not leave the signal handler waiting for the multi-hour suite timeout.
    with ThreadPoolExecutor(max_workers=max(1, len(running))) as stopper:
        list(stopper.map(stop_tree, running))
    raise KeyboardInterrupt(f'signal {signum}')


def scratch_usage(tmp, top=SCRATCH_TOP):
    """Largest consumers under TMPDIR: allocated bytes per pytest test (its tmp_path, all
    workers and repeats summed) or per other top-level entry; hard links counted once."""
    totals, seen = Counter(), set()
    pytest_root = tmp / 'pytest'

    def owner(path):
        relative = path.relative_to(tmp).parts
        if path.is_relative_to(pytest_root) and len(relative) >= 2:
            index = 2 if PYTEST_WORKER.fullmatch(relative[1]) and len(relative) >= 3 else 1
            return 'pytest:' + re.sub(r'\d+\Z', '', relative[index])
        # Leaked per-process entries (name-<pid>, name-<uuid>, tempfile's tmpXXXXXXXX) group by stem.
        anonymous = ANONYMOUS_TEMP.fullmatch(relative[0])
        if anonymous:
            return anonymous[1] + '*'
        return RUN_SUFFIX.sub('', relative[0]) or relative[0]

    for directory, dirs, files in os.walk(tmp, onerror=lambda error: None):
        for name in dirs + files:
            path = Path(directory) / name
            try:
                info = path.lstat()
            except OSError:
                continue
            if (info.st_dev, info.st_ino) in seen:
                continue
            seen.add((info.st_dev, info.st_ino))
            totals[owner(path)] += info.st_blocks * 512
    return [{'name': name, 'bytes': size} for name, size in totals.most_common(top) if size]


def remove_tree(path):
    """rmtree that first restores u+rwx on our own read-only directories (tests chmod them)."""
    if not path.exists() and not path.is_symlink():
        return
    if path.is_symlink() or not path.is_dir():
        path.unlink()
        return

    def writable(directory):
        try:
            info = os.lstat(directory)
            if stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid() and stat.S_IMODE(info.st_mode) & 0o700 != 0o700:
                os.chmod(directory, stat.S_IMODE(info.st_mode) | 0o700)
        except OSError:
            pass

    writable(path)
    for directory, dirs, _ in os.walk(path):  # top-down: fix each child before descending
        for name in dirs:
            writable(os.path.join(directory, name))
    shutil.rmtree(path, ignore_errors=True)


def clean_scratch(root):
    removed = []
    for side in ('head', 'base'):
        for name in (*SCRATCH, *(p.name for p in (root / side).glob('target-cpu-gate-*'))):
            path = root / side / name
            if path.exists() or path.is_symlink():
                remove_tree(path)
                removed.append(str(path))
    return removed


def persistent_cargo_home(env=None):
    """The architecture Cargo home where tools are installed without root (see AGENTS.md)."""
    home = Path((os.environ if env is None else env).get('HOME') or Path.home())
    return home / '.cache/cuteafd/cargo-home' / platform.machine()


def nextest_for(env):
    found = shutil.which('cargo-nextest', path=env.get('PATH'))
    if found:
        return found
    persistent = persistent_cargo_home() / 'bin/cargo-nextest'
    return str(persistent) if persistent.is_file() and os.access(persistent, os.X_OK) else None


def toolchain_path(env):
    """PATH that finds cargo and rustc for this process and every child.

    A systemd user unit starts without ~/.cargo/bin on PATH, which used to reject the
    gate before any work. When either tool is missing, prepend the standard Cargo bin
    directories that exist, in precedence order (see toolchain_bins). Returns
    (path, directory) where directory is the one that supplied the missing tools, or
    None when PATH already worked or no candidate supplies them (the caller then
    errors)."""
    path = env.get('PATH') or ''
    missing = [tool for tool in TOOLCHAIN if not shutil.which(tool, path=path)]
    if not missing:
        return path, None
    added = [str(directory) for directory in toolchain_bins(env) if directory.is_dir()]
    combined = os.pathsep.join([*added, path]) if path else os.pathsep.join(added)
    if not added or any(not shutil.which(tool, path=combined) for tool in missing):
        return path, None
    used = next((directory for directory in added
                 if all(shutil.which(tool, path=os.pathsep.join([directory, path])) for tool in missing)), added[0])
    return combined, used


def toolchain_bins(env):
    """Bin directories that may hold cargo/rustc, in precedence order: the Cargo
    homes' bin/, Homebrew's prefix, then the toolchain rustup resolves (only when
    its /opt/rustup home exists)."""
    bins = [home / 'bin' for home in cargo_homes(env)]
    bins.append(HOMEBREW_BIN)
    resolved = rustup_toolchain_bin(env=env)
    if resolved is not None:
        bins.append(resolved)
    return bins


def cargo_homes(env):
    """Candidate Cargo homes in precedence order: $CARGO_HOME, ~/.cargo, then the
    persistent architecture one nextest_for falls back to."""
    homes = [Path(env['CARGO_HOME'])] if env.get('CARGO_HOME') else []
    homes.append(Path(env.get('HOME') or Path.home()) / '.cargo')
    homes.append(persistent_cargo_home(env))
    return homes


def rustup_toolchain_bin(root=RUSTUP_HOME, env=None):
    """Bin directory of the cargo rustup resolves from its home at root, or None.

    Ask rustup rather than guessing the toolchain directory name; a missing home or
    a rustup that cannot answer leaves the caller on the other candidates."""
    if not root.is_dir():
        return None
    env = dict(os.environ if env is None else env, RUSTUP_HOME=str(root))
    rustup = root / 'bin/rustup'
    if not (rustup.is_file() and os.access(rustup, os.X_OK)):
        found = shutil.which('rustup', path=env.get('PATH'))
        if not found:
            return None
        rustup = Path(found)
    try:
        result = subprocess.run([str(rustup), 'which', 'cargo'], capture_output=True, text=True,
                                timeout=10, env=env)
    except (OSError, subprocess.SubprocessError):
        return None
    resolved = Path(result.stdout.strip()) if result.returncode == 0 and result.stdout.strip() else None
    return resolved.parent if resolved is not None and resolved.is_file() else None


def resolved_child_tools(env):
    """Resolve rustup before fixtures replace HOME, and find host build tools."""
    env = dict(env)
    roots = [Path(env['RUSTUP_HOME'])] if env.get('RUSTUP_HOME') else []
    roots += [Path(env.get('HOME') or Path.home()) / '.rustup', RUSTUP_HOME]
    toolchain = next((found for root in roots
                      if (found := rustup_toolchain_bin(root=root, env=env)) is not None), None)
    directories = ([str(toolchain)] if toolchain else [])
    directories += [env.get('PATH', '')]
    if HOMEBREW_BIN.is_dir():
        directories.append(str(HOMEBREW_BIN))
    path = os.pathsep.join(directories)
    tools = {name: shutil.which(name, path=path) for name in
             ('cargo', 'rustc', 'nasm', 'cmake', 'cc', 'c++', 'make', 'ninja', 'pkg-config')}
    return path, dict(toolchain_bin=str(toolchain) if toolchain else None, tools=tools)


def cargo_build_succeeded(path):
    """Require Cargo's completion event even if an enclosing shell masks its exit."""
    finished = []
    errors = False
    for line in path.read_text(errors='replace').splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        if event.get('reason') == 'build-finished':
            finished.append(event.get('success'))
        if event.get('reason') == 'compiler-message':
            errors |= event.get('message', {}).get('level') == 'error'
    return finished == [True] and not errors


def scrub_compiler_cache_env(env):
    """Isolate script fixtures, not Cargo. Never bypass compiler caches unless TJ
    asks, release requires it, or disk is short (global BUILD_CACHES=off)."""
    cleaned = dict(env)
    scrubbed = sorted(key for key in list(cleaned)
                      if key in SCRUBBED_ENV_NAMES or key.startswith(SCRUBBED_ENV_PREFIXES)
                      or CMAKE_LAUNCHER_ENV.fullmatch(key))
    for key in scrubbed:
        cleaned.pop(key, None)
    return cleaned, scrubbed


def compiler_cache_env(source, root, env):
    """Use the shipping fail-soft wrapper, with per-run config and local arch stores."""
    env = dict(env)
    home = Path(env.get('HOME') or Path.home())
    env.setdefault('CARGO_HOME', str(persistent_cargo_home(env)))
    if env.get('CUTEAFD_BUILD_CACHES') == 'off':
        env, _ = scrub_compiler_cache_env(env)
        return env
    native = home / '.cache/cuteafd/tools' / platform.machine() / 'kache'
    env['CUTEAFD_KACHE'] = env.get('CUTEAFD_KACHE') or (str(native) if native.is_file() else '1')
    env.setdefault('CUTEAFD_KACHE_CACHE_DIR', str(home / '.cache/cuteafd/kache'))
    # Reinitialize managed launchers: the inherited config/shims belong to the
    # caller's build. Preserve cache paths and unmanaged compiler wrappers.
    if env.get('CUTEAFD_KACHE_ACTIVE') and env.get('RUSTC_WRAPPER', '').endswith('/compiler-cache.sh'):
        for key in ('RUSTC_WRAPPER', 'CMAKE_C_COMPILER_LAUNCHER', 'CMAKE_CXX_COMPILER_LAUNCHER'):
            env.pop(key, None)
        for key in ('CC', 'CXX'):
            if env.get(key, '').startswith(env.get('CUTEAFD_KACHE_SHIM_DIR', '/nonexistent') + '/'):
                env.pop(key, None)
    for key in ('CUTEAFD_KACHE_ACTIVE', 'CUTEAFD_KACHE_MODE', 'CUTEAFD_KACHE_WARNING_DIR'):
        env.pop(key, None)
    helper = str(source / 'scripts/build/compiler-cache.sh')
    command = "source \"$1\"; cuteafd_compiler_cache_setup \"$2\"; exec python3 -c 'import os,json; print(json.dumps(dict(os.environ)))'"
    try:
        result = subprocess.run(['bash', '-c', command, 'cpu-gate', helper, str(root)],
                                env=env, text=True, capture_output=True, timeout=30)
        if result.stderr:
            log(result.stderr.strip())
        if result.returncode == 0:
            return json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        log(f'warning: compiler cache setup unavailable: {error}; using plain compilers')
    else:
        log('warning: compiler cache setup failed; using plain compilers')
    env, _ = scrub_compiler_cache_env(env)
    return env


def compiler_cache_receipt(env, target):
    active = env.get('CUTEAFD_KACHE_ACTIVE')
    warning = Path(env.get('CUTEAFD_KACHE_WARNING_DIR', '/nonexistent')) / 'first-failure'
    event_root = str(Path(env['KACHE_CONFIG']).parent.parent) if env.get('KACHE_CONFIG') else str(target.parent)
    record = dict(event_root=event_root, mode='fallback' if warning.is_file() else 'kache' if active else 'plain',
                  target=str(target), wrapper=env.get('RUSTC_WRAPPER', ''),
                  cache_dir=env.get('KACHE_CACHE_DIR'), hits=None, misses=None,
                  rustflags=env.get('RUSTFLAGS', ''), cargo_encoded_rustflags=env.get('CARGO_ENCODED_RUSTFLAGS', ''))
    timeouts = sorted(warning.parent.glob('timeouts/*'))
    record['invocation_timeouts'] = [path.read_text(errors='replace').strip() for path in timeouts if path.is_file()]
    if timeouts and not warning.is_file():
        record['mode'] = 'kache-with-timeouts'
    if warning.is_file():
        record['fallback'] = warning.read_text(errors='replace').strip()
    for name, command in (('rustc', ['rustc', '-vV']), ('cargo', ['cargo', '-V'])):
        try:
            version = subprocess.run(command, env=env, capture_output=True, text=True, timeout=5)
            record[name] = version.stdout.strip() if version.returncode == 0 else None
        except (OSError, subprocess.SubprocessError):
            record[name] = None
    if active:
        try:
            result = subprocess.run([active, '--json', 'stats', '--root', event_root, '--full'],
                                    env=env, capture_output=True, text=True, timeout=15)
            payload = json.loads(result.stdout)
            stats = payload.get('report', payload)['summary']
            record.update(hits=sum(stats.get(k, 0) for k in ('local_hits', 'remote_hits', 'prefetch_hits')),
                          misses=stats['misses'], stats=stats)
        except (OSError, subprocess.SubprocessError, ValueError, KeyError) as error:
            record['stats_error'] = str(error)
    return record


def _load_hwlock():
    """scripts/hw/hwlock.py's ticket queue: numbered, flocked SEQ.PID.ticket entries."""
    spec = importlib.util.spec_from_file_location('cuteafd_hwlock', REPO / 'scripts/hw/hwlock.py')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


HWLOCK = _load_hwlock()


def _claim_slot(directory, slots, ahead):
    """Flock the (ahead+1)-th free slot, leaving the first `ahead` to the older
    waiters: (slot, handle, free slots seen), or (None, None, free) when too few
    are free. Probes release at once, so no waiter sees a slot falsely busy."""
    free = 0
    for slot in range(slots):
        lock = (directory / f'cpu-gate.{slot}.lock').open('a')
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            lock.close()
            continue
        free += 1
        if free > ahead:
            return slot, lock, free
        lock.close()
    return None, None, free


@contextmanager
def gate_lease(directory=None, slots=None, timeout=GATE_LEASE_WAIT):
    """Count whole gates, including pytest and base comparisons, on this host.

    First come, first served (hwlock's ticket queue): each waiter publishes a
    flocked SEQ.PID.ticket in cpu-gate-q/ holding its PID and start time, and
    takes a free slot only when fewer older live tickets wait than slots are
    free, so a later waiter never overtakes an earlier one. A ticket whose flock
    is free belongs to a dead process and is removed. The slot locks are flocks,
    so a killed holder releases its slot; the ticket goes once the lease is
    taken, the wait times out or the gate is stopped."""
    directory = directory or Path.home() / '.cache/cuteafd'
    slots = slots if slots is not None else (1 if platform.node().split('.')[0] == 'maxq' else 3)
    directory.mkdir(parents=True, exist_ok=True)
    queue = directory / 'cpu-gate-q'
    queue.mkdir(exist_ok=True)
    started = time.monotonic()
    log(f'waiting for gate lease ({slots} slots, timeout {timeout}s)')
    lease, ticket, handle, position = None, None, None, None
    try:
        seq = HWLOCK._next_seq(queue)
        ticket, handle = HWLOCK._publish(queue, seq, 'ticket', dict(pid=os.getpid(), created=time.time(),
                                                                    host=platform.node(), argv=sys.argv[1:][:8]))
        while True:
            ahead = sum(1 for other, _, _ in HWLOCK._live_entries(queue, 'ticket') if other < seq)
            slot, lease, free = _claim_slot(directory, slots, ahead)
            if lease is not None:
                break
            if ahead + 1 != position:
                position = ahead + 1
                log(f'gate lease queue position {position} ({ahead} older waiting, {free}/{slots} slots free)')
            if time.monotonic() - started >= timeout:
                raise TimeoutError(f'no gate lease free after {timeout}s')
            if STOPPING.wait(min(GATE_LEASE_POLL, max(0, timeout - (time.monotonic() - started)))):
                raise KeyboardInterrupt('terminated while waiting for gate lease')
    except BaseException:
        if lease is not None:
            lease.close()
        raise
    finally:
        if ticket is not None:
            ticket.unlink(missing_ok=True)
            handle.close()
    try:
        log(f'gate lease {slot}/{slots} acquired after {time.monotonic() - started:.1f}s')
        yield dict(slot=slot, slots=slots, ticket=seq, wait_s=round(time.monotonic() - started, 3))
    finally:
        lease.close()


def _placement_publications(source):
    spec = importlib.util.spec_from_file_location('cuteafd_placement_publications',
                                                  REPO / 'scripts/lib/placement_publications.py')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


PLACEMENT_VARIABLES = {'all': 'CUTEAFD_DEPLOYMENT_TEST_PROGRAMS', 'v4': 'CUTEAFD_V4_PLACEMENT_INPUTS'}
EXPORT_COMMANDS = {
    'all': ('scripts/build/cuteafd-dev.sh cpu -- python3 scripts/build/export-placement-inputs.py '
            '--output <store>/placement-inputs/<sha> --staging <store>/placement-inputs/staging-<sha> --previous <current>'),
    'v4': ('scripts/build/cuteafd-dev.sh cpu -- python3 scripts/build/compare-sm-exports.py '
           '--v4-placement-inputs <store>/v4-placement-inputs/<sha> --output-dir <store>/v4-placement-inputs/staging-<sha>'),
}


def placement_inputs(source, env, args):
    """Choose the publications whose recorded inputs key equals this checkout's (no Cargo, no lease).

    Returns (record, error). record maps 'all'/'v4' to the chosen path, how it
    was chosen and the key; error is set when a required inventory has no match.
    """
    if not args.cargo or args.skip_live_planners:
        return dict(skipped='--skip-live-planners' if args.cargo else 'no cargo suite'), None
    publications = _placement_publications(source)
    started = time.monotonic()
    try:
        fingerprints = publications.checkout_fingerprints(source)
    except (OSError, ValueError, KeyError, AttributeError) as error:
        return {}, f'cannot compute placement inputs key for {source}: {error}'
    builds = Path(env.get('HOME', str(Path.home()))) / '.cache/cuteafd/builds'
    required = {'all': not getattr(args, 'cargo_filter', None),
                'v4': getattr(args, 'full', False) and not getattr(args, 'cargo_filter', None)}
    record, errors = {}, []
    for kind, variable in PLACEMENT_VARIABLES.items():
        key = publications.inputs_key(fingerprints[kind])
        store = builds / publications.STORES[kind]
        given = env.get(variable)
        if given:
            root = Path(given)
            root = root.parent.parent if kind == 'all' else root
            recorded = publications.recorded_fingerprint(root)
            matches = recorded is not None and publications.inputs_key(recorded) == key
            entry = dict(path=given, how=f'explicit {variable}', key=key, matches=matches)
            if not matches:
                differing = publications.differing(fingerprints[kind], recorded)
                errors.append(f'explicit {variable}={given} does not record this checkout\'s inputs key {key[:16]} '
                              f'(differs: {", ".join(differing[:6])}{" ..." if len(differing) > 6 else ""})')
        else:
            path, how = publications.resolve(store, fingerprints[kind])
            entry = dict(key=key, how=how, path=None)
            if path is not None:
                entry['path'] = str(path / 'share/PROGRAMS.json') if kind == 'all' else str(path)
                entry['engine_commit'] = (publications.recorded_fingerprint(path) or {}).get('engine_commit')
            elif required[kind]:
                current = publications.recorded_fingerprint(store / 'current')
                differing = publications.differing(fingerprints[kind], current)
                compiled = getattr(publications, 'resolve_compiled', lambda *a: None)(store, fingerprints[kind])
                remedy = (f're-attest it in seconds, no compile (only the selection tier differs): '
                          f'python3 scripts/build/export-placement-inputs.py --reattest-from {compiled} '
                          f'--output {store}/<sha>{" --v4" if kind == "v4" else ""}'
                          if compiled is not None else f'publish one from this commit: {EXPORT_COMMANDS[kind]}')
                errors.append(f'no {publications.STORES[kind]} publication records this checkout\'s inputs key '
                              f'{key[:16]} (vs current: {", ".join(differing[:6])}{" ..." if len(differing) > 6 else ""}); '
                              f'{remedy}, then rerun (or set {variable})')
        record[kind] = entry
    record['seconds'] = round(time.monotonic() - started, 3)
    return record, '; '.join(errors) or None


def apply_placement_inputs(env, record):
    for kind, variable in PLACEMENT_VARIABLES.items():
        entry = record.get(kind) or {}
        if entry.get('path') and not env.get(variable):
            env[variable] = entry['path']
    return env


def validate_full_test_ids(source, root, args, env):
    """Check exclusions against compiled libtest IDs, independently of the runner."""
    path = root / 'logs/cargo-test-inventory.log'
    code, seconds = run_logged(['nice', '-n', '19', 'cargo', 'test', '--workspace', '--locked',
                                '--lib', '--bins', '--tests', '--', '--list', '--format', 'terse'], path, env, source / 'rust', args.cargo_timeout)
    names = {line.removesuffix(': test') for line in path.read_text(errors='replace').splitlines()
             if line.endswith(': test')}
    missing = sorted(set(FULL_TESTS) - names)
    result = dict(inventory_exit=code, inventory_s=round(seconds), inventory_log=str(path),
                  missing_full_tests=missing)
    if code:
        result['error'] = f'test inventory failed (exit {code})'
    elif not names:
        result['error'] = 'test inventory is empty'
    elif missing:
        result['error'] = 'FULL_TESTS ids match zero tests: ' + ', '.join(missing)
    return result


def cargo(source, root, args, env):
    run_id = uuid.uuid4().hex[:12]
    env = compiler_cache_env(source, root / 'compiler-cache-runs' / run_id, env)
    mode = 'kache' if env.get('CUTEAFD_KACHE_ACTIVE') else 'plain'
    target = root / f'target-cpu-gate-{mode}-{run_id}'
    checked([sys.executable, str(source / 'scripts/build/assert-build-filesystem.py'), str(target)])
    env = {**env, 'CARGO_TARGET_DIR': str(target), 'CARGO_BUILD_JOBS': str(getattr(args, 'cargo_jobs', 16)),
           'RUST_TEST_THREADS': str(getattr(args, 'cargo_jobs', 16))}
    env.setdefault('CUTEAFD_DEPLOYMENT_TEST_PROGRAMS',
                   str(Path(env.get('HOME', str(Path.home()))) / '.cache/cuteafd/builds/placement-inputs/current/share/PROGRAMS.json'))
    placement = getattr(args, 'placement_inputs', None)
    log('cargo: compiling tests (build slot held while compiling)')
    build_log = root / 'logs/cargo-build.log'
    code, build_s = run_logged(['nice', '-n', '19', str(source / 'scripts/build/build-slot.sh'), 'cargo', 'test', '--workspace', '--locked',
                                '--no-run', '--message-format=json-render-diagnostics'], build_log, env, source / 'rust', args.cargo_build_timeout)
    complete = cargo_build_succeeded(build_log)
    result = dict(suite='cargo', build_exit=code, build_complete=complete, build_s=round(build_s), build_log=str(build_log),
                  compiler_cache=compiler_cache_receipt(env, target),
                  scrubbed_env=[], deployment_test_programs=env['CUTEAFD_DEPLOYMENT_TEST_PROGRAMS'],
                  **({'placement_inputs': placement} if placement is not None else {}))
    if code or not complete:
        tail = [line for line in build_log.read_text(errors='replace').splitlines() if line.startswith('error')][:5]
        return {**result, 'status': 'failed', 'error': 'compile failed: ' + ('; '.join(tail) or
                f'exit {code}; missing or unsuccessful build-finished event')}
    if not getattr(args, 'cargo_filter', None):
        result.update(validate_full_test_ids(source, root, args, env))
    if 'error' in result:
        return {**result, 'status': 'failed'}
    full = getattr(args, 'full', False)
    test_filter = getattr(args, 'cargo_filter', None)
    if not args.skip_live_planners:
        # Installed launcher checks import the same pytest helpers as the script suite.
        env['CUTEAFD_TEST_PYTHON'] = str(python_for(source))
    if not args.skip_live_planners:
        env.setdefault('CUTEAFD_DEPLOYMENT_TEST_HF_HOME',
                       env.get('HF_HOME') or str(Path(env.get('HOME', str(Path.home()))) / '.cache/huggingface'))
    skipped_full = [] if full else list(FULL_TESTS)
    skipped_live = list((*LIVE_PLANNERS, *INSTALLED_PLANNERS, *MERGE_INSTALLED_PLANNERS)) if args.skip_live_planners else []
    skipped = list(dict.fromkeys(skipped_full + skipped_live))
    skips = [flag for name in skipped for flag in ('--skip', name)]
    test_args = ['nice', '-n', '19', 'cargo', 'test', '--workspace', '--locked', '--no-fail-fast', '--', *skips]
    if test_filter:
        test_args.insert(test_args.index('--'), test_filter)
    if skips and not test_filter:
        test_args.append('--exact')
    nextest = nextest_for(env)
    # nextest's store is workspace-relative, independent of CARGO_TARGET_DIR.
    profile_name = 'cpu-gate-full' if full else 'cpu-gate'
    report = root / f'logs/nextest/{profile_name}/junit.xml'
    if nextest:
        config = root / 'nextest.toml'
        profile = source / 'rust/.config/nextest.toml'
        if not profile.is_file():  # --base may predate nextest support.
            profile = REPO / 'rust/.config/nextest.toml'
        profile_text = profile.read_text()
        if full and '[profile.cpu-gate-full]' not in profile_text:
            full_profile = (REPO / 'rust/.config/nextest.toml').read_text().split('[profile.cpu-gate-full]', 1)[1]
            profile_text += '\n[profile.cpu-gate-full]' + full_profile
        config.write_text('[store]\ndir = ' + json.dumps(str(root / 'logs/nextest')) + '\n' + profile_text)
        test_args = ['nice', '-n', '19', nextest, 'nextest', 'run', '--workspace', '--locked',
                     '--config-file', str(config), '--profile', profile_name, '--no-fail-fast', '--test-threads',
                     env['RUST_TEST_THREADS']]
        expressions = [f'not test(={name})' for name in skipped]
        if test_filter:
            expressions.append(f'test({test_filter})')
        if expressions:
            test_args += ['-E', ' & '.join(expressions)]
    if nextest:
        report.unlink(missing_ok=True)
    log(f"cargo: running tests ({'nextest' if nextest else 'cargo test'}, {env['RUST_TEST_THREADS']} workers, no build slot)")
    test_log = root / 'logs/cargo-test.log'
    code, test_s = run_logged(test_args, test_log, env, source / 'rust', args.cargo_timeout)
    text = test_log.read_text(errors='replace')
    totals = [tuple(map(int, m)) for m in CARGO_RESULT.findall(text)]
    if nextest:
        totals, nextest_ids = parse_nextest(report)
        if not sum(t[0] + t[1] for t in totals):
            code = code or 1  # Passing doctests cannot mask an empty/missing nextest run.
    passed, failed, ignored = (sum(t[i] for t in totals) for i in range(3))
    ids = nextest_ids if nextest else sorted(set(CARGO_FAIL.findall(text)))
    if nextest and code != 124 and not test_filter:
        doc_log = root / 'logs/cargo-doc.log'
        doc_code, doc_s = run_logged(['nice', '-n', '19', 'cargo', 'test', '--workspace', '--locked', '--doc'],
                                    doc_log, env, source / 'rust', args.cargo_timeout)
        doc_text = doc_log.read_text(errors='replace')
        doc_totals = [tuple(map(int, m)) for m in CARGO_RESULT.findall(doc_text)]
        passed += sum(t[0] for t in doc_totals)
        failed += sum(t[1] for t in doc_totals)
        ignored += sum(t[2] for t in doc_totals)
        ids = sorted(set(ids + CARGO_FAIL.findall(doc_text)))
        totals.extend(doc_totals)
        code = code or doc_code
        test_s += doc_s
    if getattr(args, 'slow', False):
        for crate, name in SLOW_TESTS:
            slow_log = root / f'logs/slow-{name}.log'
            slow_code, seconds = run_logged(['nice', '-n', '19', 'cargo', 'test', '--locked', '-p', crate,
                                             name, '--', '--ignored'], slow_log, env, source / 'rust', args.cargo_timeout)
            slow_text = slow_log.read_text(errors='replace')
            slow_totals = [tuple(map(int, m)) for m in CARGO_RESULT.findall(slow_text)]
            passed += sum(t[0] for t in slow_totals)
            ignored = max(0, ignored - min(1, sum(t[0] + t[1] for t in slow_totals)))
            failed += sum(t[1] for t in slow_totals)
            ids = sorted(set(ids + CARGO_FAIL.findall(slow_text)))
            code = code or slow_code or (0 if sum(t[0] + t[1] for t in slow_totals) == 1 else 1)
            test_s += seconds
    result.update(exit=code, test_s=round(test_s), log=str(test_log), passed=passed, failed=failed, ignored=ignored,
                  binaries=len(totals), failing=ids, full=full,
                  skipped_full_tests=skipped_full, skipped_live_planners=skipped_live)
    if code == 124:
        result.update(status='failed', error=f'timed out after {args.cargo_timeout} s')
    elif passed == 0:
        result.update(status='failed', error='no test summaries parsed (nothing ran?)')
    elif failed or ids or code:
        result.update(status='failed', error=f'{failed} failed' + ('' if failed or ids else f' (exit {code}, no failing ids parsed)'))
    else:
        result['status'] = 'pass'
    if result['status'] == 'failed' and set(ids).intersection(INSTALLED_INPUT_TESTS):
        reasons = sorted(set(PLACEMENT_INPUT_ERROR.findall(text)))
        if reasons:
            result['error'] += '; ' + '; '.join(reasons)
    return result


def parse_nextest(report):
    """Use nextest's machine report, including crashes/timeouts, not its progress lines."""
    if not report.is_file():
        return [], []
    try:
        suites = ET.parse(report).getroot().findall('testsuite')
    except ET.ParseError:
        return [], []
    totals, ids = [], []
    for suite in suites:
        cases = suite.findall('testcase')
        failed = [c for c in cases if c.find('failure') is not None or c.find('error') is not None]
        skipped = sum(c.find('skipped') is not None for c in cases)
        totals.append((len(cases) - len(failed) - skipped, len(failed), skipped))
        ids.extend(c.attrib['name'] for c in failed)
    return totals, sorted(set(ids))


def benches(source, root, args, env):
    """Release-mode bound checks: each bench passes only when its test ran and passed."""
    run_id = uuid.uuid4().hex[:12]
    env = compiler_cache_env(source, root / 'compiler-cache-runs' / run_id, env)
    mode = 'kache' if env.get('CUTEAFD_KACHE_ACTIVE') else 'plain'
    target = root / f'target-cpu-gate-release-{mode}-{run_id}'
    checked([sys.executable, str(source / 'scripts/build/assert-build-filesystem.py'), str(target)])
    env = {**env, 'CARGO_TARGET_DIR': str(target), 'CARGO_BUILD_JOBS': str(getattr(args, 'cargo_jobs', 16))}
    result = dict(suite='benches', passed=0, failed=0, failing=[], medians={}, logs=[], scrubbed_env=[])
    build_s = test_s = 0.
    for crate, test, test_target, test_name, bounds in BENCHES:
        log(f'benches: compiling {crate}/{test} (release, build slot held while compiling)')
        build_log = root / f'logs/bench-{test}-build.log'
        code, seconds = run_logged([str(source / 'scripts/build/build-slot.sh'), 'cargo', 'test', '--release', '--locked',
                                    '-p', crate, '--test', test_target, '--no-run', '--message-format=json-render-diagnostics'], build_log, env, source / 'rust',
                                   args.cargo_build_timeout)
        build_s += seconds
        if code or not cargo_build_succeeded(build_log):
            result['failed'] += 1
            result['failing'].append(test)
            result.setdefault('errors', []).append(f'{test}: compile exit {code}')
            continue
        test_log = root / f'logs/bench-{test}.log'
        code, seconds = run_logged(['cargo', 'test', '--release', '--locked', '-p', crate, '--test', test_target, test_name, '--',
                                    '--ignored', '--nocapture', '--test-threads', '1'], test_log, {**env, **bounds},
                                   source / 'rust', args.cargo_timeout)
        test_s += seconds
        text = test_log.read_text(errors='replace')
        totals = [tuple(map(int, m)) for m in CARGO_RESULT.findall(text)]
        ran = sum(t[0] + t[1] for t in totals)
        medians = BENCH_MEDIANS.findall(text)
        if medians:
            result['medians'][test] = {name: float(value) for name, value in BENCH_VALUE.findall(medians[-1])}
        result['logs'].append(str(test_log))
        if code == 0 and ran > 0 and not any(t[1] for t in totals):
            result['passed'] += 1
        else:
            result['failed'] += 1
            result['failing'].append(test)
            result.setdefault('errors', []).append(f'{test}: ' + ('timed out' if code == 124 else 'did not run' if not ran
                                                                 else f'bound exceeded or failed (exit {code})'))
    result.update(compiler_cache=compiler_cache_receipt(env, target),
                  build_s=round(build_s), test_s=round(test_s), bounds={t: b for _, t, _, _, b in BENCHES},
                  status='pass' if result['passed'] == len(BENCHES) else 'failed')
    if result['status'] == 'failed':
        result['error'] = '; '.join(result.get('errors', []))
    return result


def scripts(source, root, args, env):
    env, scrubbed_env = scrub_compiler_cache_env(env)
    python = python_for(source)
    test_log = root / 'logs/pytest.log'
    log(f"scripts: pytest ({python}, {getattr(args, 'pytest_jobs', 16)} workers)")
    cmd = ['nice', '-n', '19', str(python), '-m', 'pytest', '-q', '-p', 'no:cacheprovider', '--basetemp',
           str(root / 'tmp/pytest'), '-n', str(getattr(args, 'pytest_jobs', 16)),
           '-p', 'no:randomly', getattr(args, 'pytest_target', 'scripts/tests')]
    code, seconds = run_logged(cmd, test_log, env, source, args.scripts_timeout)
    text = test_log.read_text(errors='replace')
    summary = PYTEST_SUMMARY.findall(text)
    counts = {key: int(value) for value, key in re.findall(r'(\d+) (passed|failed|errors?|skipped)', summary[-1] if summary else '')}
    ids = sorted(set(PYTEST_FAIL.findall(text)))
    result = dict(suite='scripts', exit=code, test_s=round(seconds), log=str(test_log), python=str(python),
                  passed=counts.get('passed', 0), failed=counts.get('failed', 0) + counts.get('error', 0) + counts.get('errors', 0),
                  skipped=counts.get('skipped', 0), failing=ids, summary=summary[-1] if summary else None,
                  scrubbed_env=scrubbed_env)
    if code == 124:
        result.update(status='failed', error=f'timed out after {args.scripts_timeout} s')
    elif not summary or result['passed'] == 0:
        result.update(status='failed', error='no pytest summary parsed (nothing ran?)')
    elif result['failed'] or ids or code:
        result.update(status='failed', error=f"{result['failed']} failed" + ('' if result['failed'] or ids else f' (exit {code})'))
    else:
        result['status'] = 'pass'
    return result


def gate(source, root, args, owned=False):
    if args.scripts or (args.cargo and getattr(args, 'full', False) and not getattr(args, 'skip_live_planners', False)):
        python_for(source)
    prepare(source, root, owned)
    # Record the gated commit before running: a checkout that moves during the
    # gate would otherwise be credited with tests that ran against older source.
    head = checked(['git', '-C', str(source), 'rev-parse', 'HEAD']).strip()
    # Never bypass Cargo caches unless TJ asks, release requires it, or disk is short.
    # Only script fixtures scrub ambient launchers; BUILD_CACHES=off is global.
    env = {**os.environ, 'TMPDIR': str(root / 'tmp'), 'PYTHONDONTWRITEBYTECODE': '1'}
    placement, error = placement_inputs(source, env, args)
    args.placement_inputs = placement
    if error:
        log(f'placement inputs: {error}')
        return dict(source=str(source), head=head, dirty=False, moved=False, scratch=[], scrubbed_env=[],
                    placement_inputs=placement, status='failed',
                    suites=[dict(suite='cargo', status='failed', error=f'placement inputs: {error}',
                                 passed=0, failed=0, failing=[], placement_inputs=placement)])
    env = apply_placement_inputs(env, placement)
    scrubbed_env = []
    requested = [fn for enabled, fn in ((args.cargo, cargo), (args.scripts, scripts),
                                         (args.benches, benches)) if enabled]
    # Cargo and its release benches share compiler resources; only pytest overlaps them.
    def rust_suites():
        return [fn(source, root, args, env) for fn in requested if fn is not scripts]
    with ThreadPoolExecutor(max_workers=1 if getattr(args, 'jobs', 2) == 1 else 2) as pool:
        rust = pool.submit(rust_suites)
        python = pool.submit(scripts, source, root, args, env) if args.scripts else None
        suites = rust.result()
        if python is not None:
            suites.append(python.result())
    for suite in suites:
        suite['scrubbed_env'] = sorted(set(suite.get('scrubbed_env', [])) | set(scrubbed_env))
    suites.sort(key=lambda suite: ('cargo', 'scripts', 'benches').index(suite['suite']))
    scratch = scratch_usage(root / 'tmp')
    moved = checked(['git', '-C', str(source), 'rev-parse', 'HEAD']).strip() != head
    dirty = bool(checked(['git', '-C', str(source), 'status', '--porcelain', '--untracked-files=no']).strip())
    passed = suites and all(s['status'] == 'pass' for s in suites) and not moved
    return dict(source=str(source), head=head, dirty=dirty, moved=moved, suites=suites, scratch=scratch,
                scrubbed_env=scrubbed_env, placement_inputs=placement, status='pass' if passed else 'failed')


def render(record):
    lines = [f"# CPU gate {record['task']}: {record['verdict']}", '',
             f"HEAD {record['head'][:12]}{' (dirty)' if record['dirty'] else ''}" +
             (' (moved during the gate: rerun)' if record.get('moved') else '') +
             (f", base {record['base']['head'][:12]}" if record.get('base') else ''), '',
             '| Suite | Status | Passed | Failed | Seconds | Note |', '| --- | --- | ---: | ---: | ---: | --- |']
    for suite in record['suites']:
        note = suite.get('error', '')
        if suite.get('compiler_cache'):
            cache = suite['compiler_cache']
            note += f" cache={cache['mode']} hits={cache['hits']} misses={cache['misses']}"
        if suite.get('skipped_live_planners'):
            note = (note + '; ' if note else '') + 'live planner tests skipped (--skip-live-planners)'
        if suite.get('skipped_full_tests'):
            note = (note + '; ' if note else '') + f"default tier: {len(suite['skipped_full_tests'])} full tests excluded; merge gate (use --full for releases)"
        elif suite.get('full'):
            note = (note + '; ' if note else '') + 'full tier'
        for test, values in suite.get('medians', {}).items():
            note = (note + '; ' if note else '') + f"{test} medians " + ', '.join(f'{k} {v:.0f} us' for k, v in values.items())
        lines.append(f"| {suite['suite']} | {suite['status']} | {suite.get('passed', '')} | {suite.get('failed', '')} | "
                     f"{suite.get('build_s', 0) + suite.get('inventory_s', 0) + suite.get('test_s', 0)} | {note} |")
    for suite in record['suites']:
        placement = suite.get('placement_inputs') or {}
        for kind in ('all', 'v4'):
            entry = placement.get(kind)
            if entry and entry.get('path'):
                lines.append(f"\nPlacement inputs ({kind}): `{entry['path']}` ({entry['how']}, key {entry['key'][:16]})")
    for suite in record['suites']:
        if suite.get('failing'):
            lines += ['', f"## Failing {suite['suite']} ids", *[f'- {i}' for i in suite['failing']]]
    if record.get('scratch'):
        lines += ['', '## Largest scratch consumers (TMPDIR at suite end)', '', '| Bytes | Owner |', '| ---: | --- |']
        lines += [f"| {entry['bytes'] / (1 << 20):,.0f} MiB | {entry['name']} |" for entry in record['scratch']]
    if record.get('new_failing') is not None:
        lines += ['', '## New against base']
        lines += [f'- {suite}: {i}' for suite, ids in record['new_failing'].items() for i in ids] or ['- none']
    return '\n'.join(lines) + '\n'


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--jobs', type=int, default=os.environ.get('CUTEAFD_TEST_JOBS', max(1, (os.cpu_count() or 2) // 2)),
                        help='total CPU worker budget (default: CUTEAFD_TEST_JOBS or half logical CPUs)')
    parser.add_argument('--full', action='store_true', help='include full-plan/cache and installed-checkpoint tests (required for releases)')
    parser.add_argument('--slow', action='store_true', help='also run explicit ignored CPU soaks (required at release cuts; never enables GPU tests)')
    parser.add_argument('--task', required=True, help='build directory name under ~/.cache/cuteafd/builds')
    parser.add_argument('--cargo', nargs='?', const='', metavar='FILTER', help='Cargo suite, optionally a focused test filter (no gate lease)')
    parser.add_argument('--scripts', nargs='?', const='scripts/tests', metavar='TARGET', help='script suite, optionally a focused pytest path/node (no gate lease)')
    parser.add_argument('--benches', action='store_true', help='release host-cost bounds (BENCHES), recorded as their own suite')
    parser.add_argument('--skip-live-planners', action='store_true', help='skip live V4 and installed-checkpoint planners (explicitly recorded)')
    parser.add_argument('--base', metavar='REV', help='also gate REV in a detached worktree; fail only on new failing ids')
    parser.add_argument('--source', type=Path, default=REPO, help='checkout to gate (default: this one)')
    parser.add_argument('--keep', action='store_true', help='keep tmp/ and the Cargo targets after the run (default: delete)')
    parser.add_argument('--cargo-build-timeout', type=int, default=7200)
    parser.add_argument('--cargo-timeout', type=int, default=5400)
    parser.add_argument('--scripts-timeout', type=int, default=3600)
    args = parser.parse_args()
    if not NAME.fullmatch(args.task):
        parser.error('--task must be a plain name')
    args.cargo_filter = args.cargo or None
    args.pytest_target = args.scripts or 'scripts/tests'
    args.cargo, args.scripts = args.cargo is not None, args.scripts is not None
    if not (args.cargo or args.scripts or args.benches):
        args.cargo = args.scripts = True
    if args.jobs < 1:
        parser.error('--jobs must be positive')
    # A systemd unit without ~/.cargo/bin on PATH otherwise burns a whole gate
    # (cargo exit 127 plus the scripts that shell out to rustc). Recover from the
    # standard Cargo locations before refusing: PATH here reaches every child.
    path, used = toolchain_path(os.environ)
    if used:
        os.environ['PATH'] = path
        log(f'PATH: {used} supplies cargo/rustc (added to PATH)')
    missing = [tool for tool in TOOLCHAIN if not shutil.which(tool)]
    if missing and (args.cargo or args.benches or args.scripts):
        parser.error(f'{", ".join(missing)} not on PATH; pass PATH including ~/.cargo/bin '
                     '(systemd-run --setenv=PATH=...)')
    os.environ['PATH'], args.resolved_tools = resolved_child_tools(os.environ)
    log(f"resolved child tools: {json.dumps(args.resolved_tools, sort_keys=True)}")
    concurrent =args.scripts and (args.cargo or args.benches)
    args.cargo_jobs = max(1, args.jobs // 2) if concurrent else args.jobs
    args.pytest_jobs = max(1, args.jobs - args.cargo_jobs) if concurrent else args.jobs
    root = BUILDS / args.task
    root.mkdir(parents=True, exist_ok=True)
    signal.signal(signal.SIGTERM, interrupt)
    signal.signal(signal.SIGHUP, interrupt)
    signal.signal(signal.SIGINT, interrupt)
    if not args.base:
        # Fail in seconds, before waiting for a lease or compiling anything.
        _, error = placement_inputs(args.source.resolve(), dict(os.environ), args)
        if error:
            record = dict(task=args.task, verdict='failed', status='failed', exit=1, error=f'placement inputs: {error}',
                          head=checked(['git', '-C', str(args.source), 'rev-parse', 'HEAD']).strip(),
                          dirty=False, suites=[dict(suite='cargo', status='failed', error=f'placement inputs: {error}')])
            (root / 'cpu-gate.json').write_text(json.dumps(record, indent=2) + '\n')
            (root / 'cpu-gate.md').write_text(render(record))
            log(f'verdict failed before compiling: placement inputs: {error}')
            return 1
    try:
        whole_gate = (args.cargo and not args.cargo_filter) or (args.scripts and args.pytest_target == 'scripts/tests') or args.benches
        with gate_lease() if whole_gate else nullcontext(None) as lease:
            args.gate_lease = lease
            return run_gate(args, root)
    except (KeyboardInterrupt, TimeoutError) as error:
        code = 128 + TERMINATED_SIGNAL if TERMINATED_SIGNAL else 130 if isinstance(error, KeyboardInterrupt) else 75
        record = dict(task=args.task, verdict='terminated' if code != 75 else 'failed',
                      status='terminated' if code != 75 else 'failed', exit=code, error=str(error),
                      head=checked(['git', '-C', str(args.source), 'rev-parse', 'HEAD']).strip(),
                      dirty=False, suites=[])
        (root / 'cpu-gate.json').write_text(json.dumps(record, indent=2) + '\n')
        (root / 'cpu-gate.md').write_text(render(record))
        log(f"{record['verdict']}: {error} (exit {code})")
        return code
    finally:
        if args.keep:
            log(f'--keep: scratch and Cargo targets left under {root}')
        else:
            signal.signal(signal.SIGINT, signal.SIG_IGN)  # finish cleaning on a second ^C
            removed = clean_scratch(root)
            if removed:
                log('removed scratch: ' + ', '.join(removed))


def run_gate(args, root):
    record = {'task': args.task, 'started': time.strftime('%Y-%m-%dT%H:%M:%S%z'),
              'gate_lease': getattr(args, 'gate_lease', None),
              'resolved_tools': getattr(args, 'resolved_tools', None),
              'full': getattr(args, 'full', False),
              'skip_live_planners': args.skip_live_planners, **gate(args.source.resolve(), root / 'head', args)}
    if args.base:
        base_source = root / 'base-src'
        if base_source.exists():
            checked(['git', '-C', str(base_source), 'checkout', '-q', '--detach', args.base])
        else:
            checked(['git', '-C', str(args.source), 'worktree', 'add', '-q', '--detach', str(base_source), args.base])
        record['base'] = gate(base_source, root / 'base', args, owned=True)
        record['new_failing'] = {}
        for suite in record['suites']:
            before = next((s for s in record['base']['suites'] if s['suite'] == suite['suite']), {})
            record['new_failing'][suite['suite']] = sorted(set(suite.get('failing', [])) - set(before.get('failing', [])))
        # A shared named test failure may be tolerated; a timeout, moved HEAD,
        # missing build/report, or unexplained failure must never become green
        # just because both failing-id sets happen to be empty.
        comparable = all(not side.get('moved') and all(
            suite.get('passed', 0) > 0 and (suite['status'] == 'pass' or (
                suite.get('failed', 0) > 0
                and suite['failed'] == len(suite.get('failing', []))
                and suite.get('exit', 0) != 124
                and suite.get('build_exit', 0) == 0
                and suite.get('build_complete', True)))
            for suite in side['suites']) for side in (record, record['base']))
        record['verdict'] = 'pass' if comparable and not any(record['new_failing'].values()) else 'failed'
    else:
        record['verdict'] = record['status']
    (root / 'cpu-gate.json').write_text(json.dumps(record, indent=2) + '\n')
    (root / 'cpu-gate.md').write_text(render(record))
    sys.stdout.write(render(record))
    log(f"verdict {record['verdict']}: {root / 'cpu-gate.md'}")
    return 0 if record['verdict'] == 'pass' else 1


if __name__ == '__main__':
    sys.exit(main())
