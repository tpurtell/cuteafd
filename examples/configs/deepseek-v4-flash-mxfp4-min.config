# CUTEAFD starting config: DeepSeek V4 Flash 0731, official MXFP4, min (1x RTX + 2x Spark).
#
# Reproduces the v2.0.0 release card for this cell; see docs/models/deepseek_v4.md.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/deepseek-v4-flash-mxfp4-min.config --dry-run
#   ./run.sh --config examples/configs/deepseek-v4-flash-mxfp4-min.config --restart

MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
MODEL_REVISION=9e165c30e2704aec5d9d593cce3eebd58bbef1cb
SPECULATOR=dspark
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=auto
AUDIO=auto

RTX_GPUS=1
COORDINATOR_GPU=0
SPARK_COUNT=2

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v2.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v2.0.0
