# CUTEAFD starting config: Step-5-Preview, EXL3 K4 MC, original BF16 core, max (2x RTX + 6x Spark).
#
# New checkpoint, no release card yet; use a matching WIP build.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint first, then:
#
#   ./run.sh --config examples/configs/step5-exl3-k4-mc-max.config --wip SLOT --dry-run
#   ./run.sh --config examples/configs/step5-exl3-k4-mc-max.config --wip SLOT --restart
#
# The original BF16 core is the default; optional views: k8-compact and k6-compact.
# fp8-compact is not supported for this checkpoint. Experts and non-core tensors
# are shared across views; Step-5's K4 MTP stages stay unchanged.

MODEL_ID=wrldsuksgo2mars/Step-5-Preview-EXL3-K4-MC
MODEL_REVISION=4483a4bd874e8c360aec486ea72bd31d1ad7a247
CORE_VIEW=original
SPECULATOR=mtp
SPECULATOR_DEPTH=3
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=off
AUDIO=off

RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=6

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_4_HOST=REPLACE-ME-spark-4
SPARK_5_HOST=REPLACE-ME-spark-5
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4
SPARK_4_LANE_A=192.0.2.5
SPARK_5_LANE_A=192.0.2.6

# Promoted image pins; MC serving requires the matching WIP slot above.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
