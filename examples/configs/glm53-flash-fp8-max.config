# CUTEAFD starting config: GLM 5.3 Flash, official FP8, max (2x RTX + 4x Spark).
#
# Reproduces the v2.0.0 release card for this cell; see docs/models/glm5_flash.md.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/glm53-flash-fp8-max.config --dry-run
#   ./run.sh --config examples/configs/glm53-flash-fp8-max.config --restart
#
# The checkpoint is itself the FP8 release, so no separate FP8 source is read.

MODEL_ID=zai-org/GLM-5.3-Flash
MODEL_REVISION=eb9eb208eb0d988989d07a6a12d0fdeb5f52574a
GLM5_FLASH_FP8_MODEL_ID=off
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=auto
AUDIO=auto

RTX_GPUS=2
COORDINATOR_GPU=0
SPARK_COUNT=4

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v2.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v2.0.0
