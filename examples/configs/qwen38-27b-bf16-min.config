# CUTEAFD starting config: dense Qwen 3.8 27B, BF16, min (1x RTX, no Sparks).
#
# v4 candidate, RTX-only; bundled media towers follow planner admission.
# The qualified dSpark default is RadixArk/Qwen3.8-27B-DSpark.
# Download the checkpoint and drafter first, then:
#
#   ./run.sh --config examples/configs/qwen38-27b-bf16-min.config --wip SLOT --dry-run
#   ./run.sh --config examples/configs/qwen38-27b-bf16-min.config --wip SLOT --restart

MODEL_ID=Qwen/Qwen3.8-27B
MODEL_REVISION=1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
SPECULATOR=dspark
POOL_TOKENS=auto
VISION=auto
AUDIO=auto

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=0

# Under qualification: use a sealed WIP slot until v4 release images are built.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.0
