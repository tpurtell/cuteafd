# CUTEAFD starting config: DeepSeek V4 Pro 0813, EXL3 K2 calibrated, min (1x RTX + 4x Spark).
#
# Reproduces the v2.0.0 release card for this cell; see docs/models/deepseek_v4.md.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/deepseek-v4-pro-exl3-min.config --dry-run
#   ./run.sh --config examples/configs/deepseek-v4-pro-exl3-min.config --restart
#
# The v2.0.0 1x RTX card misses the logit-fidelity gate (KL 0.0605 > 0.06);
# the 2x RTX + 6 Spark card passes.

MODEL_ID=wrldsuksgo2mars/DeepSeek-V4-Pro-0813-EXL3-K2-calibrated-v1
MODEL_REVISION=7a63f24905223aff19212d65226be708950823ac
SPECULATOR=dspark
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=auto
AUDIO=auto

RTX_GPUS=1
COORDINATOR_GPU=0
SPARK_COUNT=4

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v2.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v2.0.0
