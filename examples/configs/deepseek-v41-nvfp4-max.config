# CUTEAFD starting config: DeepSeek V4.1 Flash, nvidia NVFP4, max (2x RTX + 4x Spark).
#
# Reproduces the v2.0.0 release card for this cell; see docs/models/deepseek_v41.md.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/deepseek-v41-nvfp4-max.config --dry-run
#   ./run.sh --config examples/configs/deepseek-v41-nvfp4-max.config --restart
#
# The v2.0.0 card FAILS the calibrated confident-top-1 fidelity check; prefer
# deepseek-v41-mxfp4-*.config. NVFP4 runs at TP4 only, so min uses 4 Sparks.

MODEL_ID=nvidia/DeepSeek-V4.1-Flash-NVFP4
MODEL_VARIANT=flash
MODEL_REVISION=3431dde3247c13b5957f682b1e3c6fcae2566079
EXPERT_FORMAT=native
SPARKINFER_EXL3=disable
EXL3_PAIRED_TP4=off
DSPARK=on
POOL_TOKENS=auto
VISION=spark

RTX_GPUS=2
COORDINATOR_GPU=0
SPARK_COUNT=4

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v2.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v2.0.0
