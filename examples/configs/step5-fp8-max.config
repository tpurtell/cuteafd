# CUTEAFD starting config: Step-5-Preview, official FP8, max (2x RTX + 6x Spark).
#
# Under qualification (#274): serve it from a ./wip.sh slot built from a commit
# that has serve-step5; the launcher refuses a release image or a slot without it.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint first, then:
#
#   ./run.sh --config examples/configs/step5-fp8-max.config --wip SLOT --dry-run
#   ./run.sh --config examples/configs/step5-fp8-max.config --wip SLOT --restart
#
# The checkpoint's native FP8 experts on six Sparks, attention split over both RTX.
# Text only (VISION/AUDIO off), native MTP depth 3 (SPECULATOR=off disables it).
# POOL_TOKENS=auto and an unset
# MAX_CONTEXT_TOKENS leave the KV pool and the context to serve-step5's own
# admission; an unset SPARK_DEVICE_BUDGET_BYTES takes the planned Spark budget.

MODEL_ID=stepfun-ai/Step-5-Preview
MODEL_REVISION=364b3b03fed2477aa0953fe855a2c4c8c48ee3cc
SPECULATOR=mtp
SPECULATOR_DEPTH=3
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=off
AUDIO=off

RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=6

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_4_HOST=REPLACE-ME-spark-4
SPARK_5_HOST=REPLACE-ME-spark-5
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4
SPARK_4_LANE_A=192.0.2.5
SPARK_5_LANE_A=192.0.2.6

# The promoted release pair (no release ships serve-step5 yet; --wip serves the slot).
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.0.0
