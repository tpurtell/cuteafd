# Hy4 EXL3 K4 MC, K8 compact core, max (2x RTX PRO 6000 + 6 Sparks).
#
# WIP qualification config (#2550); launch with a matching WIP slot (--wip SLOT).
# Replace the placeholder Spark hosts and documentation RoCE addresses before launching:
#
#   ./run.sh --config examples/configs/hy4-exl3-k4-mc-k8-max.config --wip SLOT --dry-run
#   ./run.sh --config examples/configs/hy4-exl3-k4-mc-k8-max.config --wip SLOT --restart
#
# ContextSplit DSA across two RTX PRO 6000 GPUs (2,149,760-token FP8 KV pool, 9/77 routed
# layers onboarded TP2, remaining 68 layers TP6 across six Sparks at 52.33 GiB/rank).

MODEL_ID=wrldsuksgo2mars/Hy4-EXL3-K4-MC
MODEL_REVISION=67346c4bdee2d8694606b4b4db9a96442e8667b7
CORE_VIEW=k8-compact
SPECULATOR=off
VISION=off
AUDIO=off
POOL_TOKENS=auto
HOST_CACHE_BYTES=auto
EXPERT_BACKEND=spark

RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=6
SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_4_HOST=REPLACE-ME-spark-4
SPARK_5_HOST=REPLACE-ME-spark-5
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4
SPARK_4_LANE_A=192.0.2.5
SPARK_5_LANE_A=192.0.2.6

COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
