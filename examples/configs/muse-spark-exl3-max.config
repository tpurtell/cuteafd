# CUTEAFD starting config: Muse Spark EXL3 K4 + Core K6, 2 RTX + 6 Sparks.
# Planned max layout; its served card and media remain under qualification (#923).
# Build a Muse WIP slot, replace the Spark hosts/addresses, then:
# ./run.sh --config examples/configs/muse-spark-exl3-max.config --wip SLOT --dry-run
# ./run.sh --config examples/configs/muse-spark-exl3-max.config --wip SLOT --restart
# TP2 attention, TP6 routed experts. Pool/context/onboarding remain automatic.
# NVIDIA DFlash2 is qualified on the min card; SPECULATOR=off disables it.

MODEL_ID=wrldsuksgo2mars/Muse-Spark-Open-EXL3-K4-Core-K6
MODEL_REVISION=89998fb177acd9a862ac8bd4fb79bfd50e940c97
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=nvidia/Muse-Spark-Open-816B-A42B-DFlash2
SPECULATOR_MODEL_REVISION=22e2669e4c60689f9bff0749a34d9d8e59ce7cd6
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=off
AUDIO=off
RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=6
SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_4_HOST=REPLACE-ME-spark-4
SPARK_5_HOST=REPLACE-ME-spark-5
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4
SPARK_4_LANE_A=192.0.2.5
SPARK_5_LANE_A=192.0.2.6

# Promoted images do not yet include Muse; use the matching WIP slot above.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.1
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.1
