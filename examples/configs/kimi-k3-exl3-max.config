# CUTEAFD starting config: Kimi K3, EXL3 K2, max (2x RTX + 6x Spark).
#
# Under qualification (#273): serve it from a ./wip.sh slot built from a commit
# that has serve-kimi; the launcher refuses a release image or a slot without it.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint first, then:
#
#   ./run.sh --config examples/configs/kimi-k3-exl3-max.config --wip SLOT --dry-run
#   ./run.sh --config examples/configs/kimi-k3-exl3-max.config --wip SLOT --restart
#
# TP2 attention on both RTX, routed experts TP6 on six Sparks, five routed
# layers onboarded to the RTX pair. Text only (VISION/AUDIO off), no drafter.
# POOL_TOKENS=auto and an unset MAX_CONTEXT_TOKENS leave the KV pool and the
# 1M compiled context to serve-kimi's own admission; an unset
# SPARK_DEVICE_BUDGET_BYTES takes the family's planned Spark budget.

MODEL_ID=wrldsuksgo2mars/Kimi-K3-EXL3-K2
MODEL_REVISION=acba35b61a672561652b16a96fca1be85c1bd875
SPECULATOR=off
POOL_TOKENS=auto
EXPERT_BACKEND=spark
RTX_EXPERT_LAYERS=5
VISION=off
AUDIO=off

RTX_GPUS=2
COORDINATOR_GPU=0
SPARK_COUNT=6

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_4_HOST=REPLACE-ME-spark-4
SPARK_5_HOST=REPLACE-ME-spark-5
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4
SPARK_4_LANE_A=192.0.2.5
SPARK_5_LANE_A=192.0.2.6

# The promoted release pair (no release ships serve-kimi yet; --wip serves the slot).
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v2.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v2.0.0
