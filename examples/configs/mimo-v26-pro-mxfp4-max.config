# CUTEAFD starting config: MiMo V2.6 Pro MOPD, official MXFP4, max (2x RTX + 6x Spark).
#
# Reproduces the v2.0.0 release card for this cell; see docs/models/mimo_v2.md.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/mimo-v26-pro-mxfp4-max.config --dry-run
#   ./run.sh --config examples/configs/mimo-v26-pro-mxfp4-max.config --restart
#
# SPECULATOR=dflash2 without SPECULATOR_MODEL_ID drafts with the snapshot's own
# dflash/. Pro needs six Sparks at both min and max.

MODEL_ID=XiaomiMiMo/MiMo-V2.6-Pro-MOPD
MODEL_REVISION=adea8e2c5373181e5a973fa1ecb343cb31af214b
SPECULATOR=dflash2
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=auto
AUDIO=auto

RTX_GPUS=2
COORDINATOR_GPU=0
SPARK_COUNT=6

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_4_HOST=REPLACE-ME-spark-4
SPARK_5_HOST=REPLACE-ME-spark-5
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4
SPARK_4_LANE_A=192.0.2.5
SPARK_5_LANE_A=192.0.2.6

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v2.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v2.0.0
