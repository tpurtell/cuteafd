# CUTEAFD qualification config: MiniMax M3.1 Flash, 1 RTX + 3 Sparks.
# WIP-only until #1856 serving qualification; requires ./wip.sh artifacts.
# Native default-prefix C16 plan: minimum 3 Sparks, default KV target 2M.
# Replace hosts and documentation addresses with your own serving endpoints.

MODEL_ID=MiniMaxAI/MiniMax-M3.1-Flash
MODEL_REVISION=54e4e69dfc452b1e94a426c24a4fdeeaa8e3ad5e
SPECULATOR=off
POOL_TOKENS=auto
HOST_CACHE_BYTES=auto
EXPERT_BACKEND=spark
VISION=off
AUDIO=off

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=3
SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
