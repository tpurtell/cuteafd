# CUTEAFD starting config: GLM 5.3 Flash, EXL3 K3.25, max (2x RTX, no Sparks).
#
# The complete model fits on the RTX pair; no idle Spark workers are attached.
# Download the checkpoint and drafter first, then:
#
#   ./run.sh --config examples/configs/glm53-flash-exl3-max.config --dry-run
#   ./run.sh --config examples/configs/glm53-flash-exl3-max.config --restart
#
# MLA, dense and shared-expert FP8 blocks are bundled in this checkpoint.

MODEL_ID=wrldsuksgo2mars/GLM-5.3-Flash-EXL3-K3.25-Core-FP8
MODEL_REVISION=d31ebc921f1f098b4a56d37aaccb3cdef4096184
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=auto
VISION=auto
AUDIO=auto

RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=0

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
