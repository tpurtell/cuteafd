# CUTEAFD starting config: GLM 5.3 Flash, EXL3 K3.25, max (2x RTX + 4x Spark).
#
# Current primary-only serving recipe; historical cards are in docs/models/glm5_flash.md.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/glm53-flash-exl3-max.config --dry-run
#   ./run.sh --config examples/configs/glm53-flash-exl3-max.config --restart
#
# MLA, dense and shared-expert FP8 blocks are bundled in this checkpoint.

MODEL_ID=wrldsuksgo2mars/GLM-5.3-Flash-EXL3-K3.25-Core-FP8
MODEL_REVISION=d31ebc921f1f098b4a56d37aaccb3cdef4096184
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=auto
AUDIO=auto

RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=4

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.0.0
