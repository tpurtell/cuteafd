# CUTEAFD starting config: GLM 5.3 Flash, tr3 4bpw (EXL3), min (1x RTX + 2x Spark).
#
# Reproduces the v2.0.0 release card for this cell; see docs/models/glm5_flash.md.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/glm53-flash-tr3-min.config --dry-run
#   ./run.sh --config examples/configs/glm53-flash-tr3-min.config --restart
#
# The quant's bundled chat template has no image markers, so vision takes the
# official template (CHAT_TEMPLATE_FROM); the FP8 projections come from
# zai-org/GLM-5.3-Flash. Download both.

MODEL_ID=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_REVISION=a5fee929cf4888b1824323e33e8a19b60129e025
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=auto
AUDIO=auto
CHAT_TEMPLATE_FROM=zai-org/GLM-5.3-Flash

RTX_GPUS=1
COORDINATOR_GPU=0
SPARK_COUNT=2

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v2.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v2.0.0
