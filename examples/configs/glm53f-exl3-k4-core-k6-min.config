# GLM 5.3 Flash native EXL3 K4 experts + K6 core, under qualification.
# 1 RTX PRO 6000 + 2 Sparks; use a matching WIP build until released.
# Replace the documentation hosts and RoCE addresses before launching.
# ./run.sh --config examples/configs/glm53f-exl3-k4-core-k6-min.config --dry-run
MODEL_ID=wrldsuksgo2mars/GLM-5.3-Flash-EXL3-K4-Core-K6
MODEL_REVISION=5d3fffe1df9c4a109bbbdafb60dc19df9fac019d
# Promoted pair; native K6 support uses the matching WIP slot until v4 ships.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.0
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=auto
AUDIO=auto
RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=2
SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
