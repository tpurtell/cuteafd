# CUTEAFD starting config: GLM 5.3, EXLR8 K2/K3/K4, native dense, min (1x RTX + 4x Spark).
#
# v4 candidate: requires native-dense integration (#659/#663); no dense overlay.
# See docs/models/glm5.md. This is not a measured release card yet.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/glm53-exlr8-min.config --dry-run
#   ./run.sh --config examples/configs/glm53-exlr8-min.config --restart

MODEL_ID=kindlingai/glm-5.3-exlr8-k2-k3-k4
MODEL_REVISION=a2b599e06c59f2ccb01aaa44e6f182ba21e39f80
SERVED_MODEL_ID=zai-org/GLM-5.3
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-DFlash2
EXLR8_MANIFEST=up1
ATTENTION_PLACEMENT=heads
POOL_TOKENS=auto
EXPERT_BACKEND=spark
L2_PREFETCH=auto
VISION=auto
AUDIO=auto

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=4

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.0.0
