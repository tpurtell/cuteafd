# CUTEAFD starting config: GLM 5.3 Flash, EXL3 K4 + Core K6, min (1x RTX + 2x Spark).
#
# Current primary-only serving recipe; historical cards are in docs/models/glm5_flash.md.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/glm53-flash-exl3-k6-min.config --dry-run
#   ./run.sh --config examples/configs/glm53-flash-exl3-k6-min.config --restart
#
# The dense core (attention, shared expert, dense FFN) and head are native EXL3 K6.

MODEL_ID=wrldsuksgo2mars/GLM-5.3-Flash-EXL3-K4-Core-K6
MODEL_REVISION=5d3fffe1df9c4a109bbbdafb60dc19df9fac019d
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=auto
AUDIO=auto

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=2

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.0
