# CUTEAFD starting config: GLM 5.3 Flash, EXL3 K4 MC, K6 compact core view, max (2x RTX, 0 Sparks).
#
# Release smoke measured on dev 912c58e04; use a matching WIP build.
# Every expert runs on the two RTX GPUs. Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/glm53-flash-exl3-k4-mc-k6-max.config --dry-run
#   ./run.sh --config examples/configs/glm53-flash-exl3-k4-mc-k6-max.config --restart
#
# The stored K6 compact core view of the MC checkpoint (original is the default;
# other views: k8-compact, fp8-compact).

# Requires an engine with MC CORE_VIEW support (dev after #1778; first release after v5.0.0).
MODEL_ID=wrldsuksgo2mars/GLM-5.3-Flash-EXL3-K4-MC
MODEL_REVISION=558931fe149f59b49d19b2376a692bd7a12fb8b7
CORE_VIEW=k6-compact
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=local
VISION=auto
AUDIO=auto

RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=0

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
