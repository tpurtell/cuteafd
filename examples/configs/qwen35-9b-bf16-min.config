# CUTEAFD starting config: dense Qwen 3.5 9B, BF16, min (1x RTX, no Sparks).
#
# v4 candidate, RTX-only; text-only native execution, no speculator.
# Download the checkpoint first, then:
#
#   ./run.sh --config examples/configs/qwen35-9b-bf16-min.config --wip SLOT --dry-run
#   ./run.sh --config examples/configs/qwen35-9b-bf16-min.config --wip SLOT --restart

MODEL_ID=Qwen/Qwen3.5-9B
MODEL_REVISION=c202236235762e1c871ad0ccb60c8ee5ba337b9a
SPECULATOR=off
POOL_TOKENS=auto
EXPERT_BACKEND=local
VISION=off
AUDIO=off
EMBEDDING=gpu
CONCURRENCY=8

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=0

# Under qualification: use a sealed WIP slot until v4 release images are built.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.0.0
