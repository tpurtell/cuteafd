# Hy4-flash EXL3 K4 MC, K8 compact core, 1x RTX PRO 6000 + 1 Spark.
#
# WIP qualification config (#2478); launch with a matching WIP slot (--wip SLOT).
# Replace the placeholder Spark host and documentation RoCE address before launching.

MODEL_ID=wrldsuksgo2mars/Hy4-flash-EXL3-K4-MC
MODEL_REVISION=cc72179113573d751ed3245e3e58d3640694378d
CORE_VIEW=k8-compact
SPECULATOR=auto
VISION=auto
AUDIO=off
POOL_TOKENS=auto
HOST_CACHE_BYTES=auto
EXPERT_BACKEND=spark
# All routed layers on the Sparks: these cards measure Spark expert scaling (TJ 2026-11-26).
RTX_EXPERT_LAYERS=0

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=1
SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_0_LANE_A=192.0.2.1

COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
