# CUTEAFD starting config: GLM 5.3 Flash, EXL3 K4 MC MUL1, original BF16 core, min (1x RTX + 2x Spark).
#
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/glm53-flash-exl3-k4-mc-mul1-min.config --dry-run
#   ./run.sh --config examples/configs/glm53-flash-exl3-k4-mc-mul1-min.config --restart
#
# The original BF16 core is the default; optional views: k8-compact, k6-compact
# and runtime-derived fp8-compact (quantizes the original selected core).

# Requires an engine with MUL1 MC CORE_VIEW and glmf:exl3-k34-mul1 support.
MODEL_ID=wrldsuksgo2mars/GLM-5.3-Flash-EXL3-K4-MC-MUL1
MODEL_REVISION=1bca67feffab2747e0e489e571185bc06336ee26
CORE_VIEW=original
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=auto
AUDIO=auto

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=2

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
