# CUTEAFD starting config: dense Qwen 3.8 27B, FP8, min (1x RTX, no Sparks).
#
# v4 candidate, RTX-only; bundled media towers follow planner admission.
# The qualified dSpark default is RadixArk/Qwen3.8-27B-DSpark.
# Download the checkpoint and drafter first, then:
#
#   ./run.sh --config examples/configs/qwen38-27b-fp8-min.config --wip SLOT --dry-run
#   ./run.sh --config examples/configs/qwen38-27b-fp8-min.config --wip SLOT --restart

MODEL_ID=Qwen/Qwen3.8-27B-FP8
MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
SPECULATOR=dspark
POOL_TOKENS=auto
VISION=auto
AUDIO=auto

RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=0

# Under qualification: use a sealed WIP slot until v4 release images are built.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.0.0
