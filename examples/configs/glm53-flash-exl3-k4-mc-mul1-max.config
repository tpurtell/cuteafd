# CUTEAFD starting config: GLM 5.3 Flash, EXL3 K4 MC MUL1, original BF16 core, max (2x RTX, 0 Sparks).
#
# Every expert runs on the two RTX GPUs. Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/glm53-flash-exl3-k4-mc-mul1-max.config --dry-run
#   ./run.sh --config examples/configs/glm53-flash-exl3-k4-mc-mul1-max.config --restart
#
# The original BF16 core is the default; optional views: k8-compact, k6-compact
# and runtime-derived fp8-compact (quantizes the original selected core).

# Requires an engine with MUL1 MC CORE_VIEW and glmf:exl3-k34-mul1 support.
MODEL_ID=wrldsuksgo2mars/GLM-5.3-Flash-EXL3-K4-MC-MUL1
MODEL_REVISION=1bca67feffab2747e0e489e571185bc06336ee26
CORE_VIEW=original
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=local
VISION=auto
AUDIO=auto

RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=0

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
