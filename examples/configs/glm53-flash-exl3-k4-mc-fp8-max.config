# GLM Flash K4 MC, block-FP8 original core, 2x RTX PRO 6000, no Sparks.
# Conversion IDs come only from original.core_tensors in cuteafd-mc.json.
MODEL_ID=wrldsuksgo2mars/GLM-5.3-Flash-EXL3-K4-MC
MODEL_REVISION=91a8dbc9c12e790c65aa1a38c6aede6a3e23a77d
CORE_VIEW=fp8-compact
# W8A8 prefill over the view's FP8 MLA, dense/shared FFN and KDA projections
# (MLA and FFN are the default; KDA is opt-in). This activation policy does not
# select or convert target weights.
GLM5_FLASH_ATTENTION_FP8_PREFILL=all
# The MC already selects head and KDA q/k/v/o; no redundant conversion keys.
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
POOL_TOKENS=auto
EXPERT_BACKEND=auto
VISION=auto
AUDIO=auto
RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=0

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
