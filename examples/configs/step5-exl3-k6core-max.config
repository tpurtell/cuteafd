# CUTEAFD starting config: Step-5-Preview EXL3 K4 + Core K6, max (2x RTX + 6x Spark).
#
# Under qualification: serve it from a ./wip.sh slot built from a commit with
# native EXL3 Step-5 (K6 core, K4 MTP, exl3-step5-k46 experts). Replace the
# REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with your own (one per
# Spark, rail A). Download the checkpoint first, then:
#
#   ./run.sh --config examples/configs/step5-exl3-k6core-max.config --wip SLOT --dry-run
#   ./run.sh --config examples/configs/step5-exl3-k6core-max.config --wip SLOT --restart
#
# EXL3 K4 routed experts (K6 for layers 88-90) on 6 Sparks; the K6 core
# runs natively on the RTX. RTX_EXPERT_LAYERS unset is pool-first auto: the
# planner onboards whole routed layers on the entry RTX once the 2M pool fits.
# Text only (VISION/AUDIO off), native MTP depth 3 (each stage's K4 head).
# MODEL_REVISION is set once the publication lands.

MODEL_ID=wrldsuksgo2mars/Step-5-Preview-EXL3-K4-Core-K6
SPECULATOR=mtp
SPECULATOR_DEPTH=3
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=off
AUDIO=off

RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=6

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_4_HOST=REPLACE-ME-spark-4
SPARK_5_HOST=REPLACE-ME-spark-5
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4
SPARK_4_LANE_A=192.0.2.5
SPARK_5_LANE_A=192.0.2.6

# The promoted release pair (native EXL3 Step-5 is not released; --wip serves the slot).
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.0
