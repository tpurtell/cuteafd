# CUTEAFD starting config: DeepSeek V4.1 Flash StridedPLE, max (2x RTX + 6x Spark).
#
# Byte-identical MXFP4 model with row-interleaved Engram storage.
# Requires a WIP/release build with StridedPLE support; v2 images lack it.
# The max layout uses all six Sparks; see docs/models/deepseek_v41.md.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/v41-flash-strided-max.config --dry-run
#   ./run.sh --config examples/configs/v41-flash-strided-max.config --restart

MODEL_ID=wrldsuksgo2mars/DeepSeek-V4.1-Flash-1017-StridedPLE
MODEL_REVISION=51b3391435c83db9c38e87e114abf7bcfe7fc9c3
MODEL_VARIANT=flash
EXPERT_FORMAT=native
SPARKINFER_EXL3=disable
SPECULATOR=dspark
POOL_TOKENS=auto
VISION=spark

RTX_GPUS=2
COORDINATOR_GPUS=0,1
SPARK_COUNT=6

SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_4_HOST=REPLACE-ME-spark-4
SPARK_5_HOST=REPLACE-ME-spark-5
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4
SPARK_4_LANE_A=192.0.2.5
SPARK_5_LANE_A=192.0.2.6

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.0.0
