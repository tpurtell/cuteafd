# Mistral Large 4 native EXL3 K4 experts + K6 core, under qualification.
# 1 RTX PRO 6000 + 5 Sparks; use a matching WIP build until released.
# Replace the documentation hosts and RoCE addresses before launching.
# ./run.sh --config examples/configs/mistral-large4-exl3-k4-core-k6-min.config --dry-run
MODEL_ID=wrldsuksgo2mars/Mistral-Large-4-EXL3-K4-Core-K6
MODEL_REVISION=03c80aebaa483d55760703ae5bc0c9734c9d67d6
SERVED_MODEL_ID=mistralai/Mistral-Large-4-1T-A52B
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.1
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.1
# Bundled mtp_dspark, checkpoint-native depth 3; SPECULATOR=off disables it.
SPECULATOR=dspark
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=off
AUDIO=off
RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=5
SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_4_HOST=REPLACE-ME-spark-4
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4
SPARK_4_LANE_A=192.0.2.5
