# CUTEAFD starting config: Muse Spark EXL3 K4 MC original BF16 core, 1 RTX + 4 Sparks.
# Text and bundled vision+audio qualified on RTX PRO 6000 (#923); VISION/AUDIO=off disables.
# Build a Muse WIP slot, replace the Spark hosts/addresses, then:
# ./run.sh --config examples/configs/muse-spark-exl3-k4-mc-min.config --wip SLOT --dry-run
# ./run.sh --config examples/configs/muse-spark-exl3-k4-mc-min.config --wip SLOT --restart
# Keep both bundled towers on Sparks; the shared physical-memory contract
# selects the served context from the admitted pool with the original BF16
# core, DFlash2 and solver-chosen RTX onboarding.
MAX_CONTEXT_TOKENS=auto
# NVIDIA DFlash2 wins C4; baseline C1 ties RadixArk. SPECULATOR=off disables it.

MODEL_ID=wrldsuksgo2mars/Muse-Spark-Open-EXL3-K4-MC
MODEL_REVISION=cc5dc2537083177e3f02ea0b2d9dfc179d40425c
# Optional stored core alternatives: k8-compact or k6-compact.
CORE_VIEW=original
SPECULATOR=dflash2
SPECULATOR_MODEL_ID=nvidia/Muse-Spark-Open-816B-A42B-DFlash2
SPECULATOR_MODEL_REVISION=22e2669e4c60689f9bff0749a34d9d8e59ce7cd6
POOL_TOKENS=auto
EXPERT_BACKEND=spark
VISION=spark
AUDIO=auto
RTX_GPUS=1
COORDINATOR_GPUS=0
SPARK_COUNT=4
SPARK_0_HOST=REPLACE-ME-spark-0
SPARK_1_HOST=REPLACE-ME-spark-1
SPARK_2_HOST=REPLACE-ME-spark-2
SPARK_3_HOST=REPLACE-ME-spark-3
SPARK_0_LANE_A=192.0.2.1
SPARK_1_LANE_A=192.0.2.2
SPARK_2_LANE_A=192.0.2.3
SPARK_3_LANE_A=192.0.2.4

# Promoted images do not yet include Muse; use the matching WIP slot above.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v4.1.2
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v4.1.2
