# CUTEAFD starting config: Qwen 3.8 Flash Next, nvidia NVFP4, min (1x RTX, local experts).
#
# Reproduces the v2.0.0 release card for this cell; see docs/models/qwen4.md.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/qwen38-nvfp4-min.config --dry-run
#   ./run.sh --config examples/configs/qwen38-nvfp4-min.config --restart
#
# Experts stay resident on the RTX (no Sparks); effective context on the card was
# 217,856 tokens, below the 262,144 agentic floor.

MODEL_ID=nvidia/Qwen3.8-Flash-Next-NVFP4
MODEL_REVISION=2061e0b0c5d92bdf7c8fbd4241bbc2af239d7e2d
SPECULATOR=mtp
SPECULATOR_DEPTH=3
POOL_TOKENS=auto
EXPERT_BACKEND=local
VISION=auto
AUDIO=auto

RTX_GPUS=1
COORDINATOR_GPU=0
SPARK_COUNT=0

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v2.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v2.0.0
