# CUTEAFD starting config: Qwen 3.8 Flash Next, EXL3 K4.25 PLE FP8, min (1x RTX, local experts).
#
# Reproduces the v2.0.0 release card for this cell; see docs/models/qwen4.md.
# Replace the REPLACE-ME Spark hosts and the 192.0.2.x RoCE addresses with
# your own (one per Spark, rail A). Download the checkpoint (and drafter)
# first, then:
#
#   ./run.sh --config examples/configs/qwen38-exl3-min.config --dry-run
#   ./run.sh --config examples/configs/qwen38-exl3-min.config --restart
#
# Experts stay resident on the RTX (no Sparks); with the automatic 2M KV target
# admission turns the vision tower off on one RTX, so the card is text only.

MODEL_ID=wrldsuksgo2mars/Qwen3.8-Flash-Next-EXL3-K4.25-PLE-FP8-v1
MODEL_REVISION=888306bd3996d6317758c07df50622829259ad17
SPECULATOR=mtp
SPECULATOR_DEPTH=3
POOL_TOKENS=auto
EXPERT_BACKEND=local
VISION=auto
AUDIO=auto

RTX_GPUS=1
COORDINATOR_GPU=0
SPARK_COUNT=0

# The promoted release pair.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-coordinator:v2.0.0
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/cuteafd-spark-expert:v2.0.0
